{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nee:dual-pipeline:facet-applicability-policy:1.0.0",
  "title": "NEE controlled-facet applicability policy",
  "description": "Declares bounded coverage requirements and versioned derivation rules for controlled semantic facets.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_id", "schema_version", "artifact_id", "canonical_digest", "policy_id", "policy_version", "status", "approval_id", "vocabularies", "created_at", "extensions"],
  "properties": {
    "contract_id": {"const": "urn:nee:dual-pipeline:facet-applicability-policy:1.0.0"},
    "schema_version": {"const": "1.0.0"},
    "artifact_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "canonical_digest": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/canonicalDigest"},
    "policy_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "policy_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"type": "string", "enum": ["proposed", "approved", "retired"]},
    "approval_id": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
    "vocabularies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"$ref": "urn:nee:dual-pipeline:facet-applicability-policy:1.0.0#/$defs/vocabularyPolicy"}
    },
    "created_at": {"type": "string", "format": "date-time"},
    "extensions": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/extensions"}
  },
  "oneOf": [
    {
      "properties": {
        "status": {"const": "proposed"},
        "approval_id": {"type": "null"}
      }
    },
    {
      "properties": {
        "status": {"type": "string", "enum": ["approved", "retired"]},
        "approval_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"}
      }
    }
  ],
  "$defs": {
    "vocabularyPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vocabulary", "definition", "controlled_value_source", "requirements"],
      "properties": {
        "vocabulary": {"type": "string", "pattern": "^[a-z][a-z0-9_:-]{1,63}$"},
        "definition": {"type": "string", "minLength": 1, "maxLength": 1000},
        "controlled_value_source": {"const": "controlled_value_registry"},
        "requirements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {"$ref": "urn:nee:dual-pipeline:facet-applicability-policy:1.0.0#/$defs/coverageRequirement"}
        }
      }
    },
    "coverageRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement_id", "object_type", "population", "minimum_assignments", "accepted_review_states", "allowed_assignment_methods", "exception_policy", "derivation_rules"],
      "properties": {
        "requirement_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
        "object_type": {"type": "string", "enum": ["node", "claim", "assertion"]},
        "population": {"type": "string", "enum": ["active_nodes", "current_claims", "current_canonical_assertions"]},
        "minimum_assignments": {"type": "integer", "minimum": 1, "maximum": 16},
        "accepted_review_states": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {"const": "approved"}
        },
        "allowed_assignment_methods": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"type": "string", "enum": ["explicit", "rule_derived", "inherited", "reviewed"]}
        },
        "exception_policy": {"$ref": "urn:nee:dual-pipeline:facet-applicability-policy:1.0.0#/$defs/exceptionPolicy"},
        "derivation_rules": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "urn:nee:dual-pipeline:facet-applicability-policy:1.0.0#/$defs/ruleBinding"}
        }
      }
    },
    "exceptionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "owner_required", "review_due_required", "maximum_review_days"],
      "properties": {
        "allowed": {"type": "boolean"},
        "owner_required": {"const": true},
        "review_due_required": {"const": true},
        "maximum_review_days": {"type": "integer", "minimum": 1, "maximum": 365}
      }
    },
    "ruleBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "rule_version", "rule_digest", "implementation_ref"],
      "properties": {
        "rule_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
        "rule_version": {"type": "integer", "minimum": 1},
        "rule_digest": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sha256"},
        "implementation_ref": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    }
  }
}
