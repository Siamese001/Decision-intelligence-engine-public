{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nee:dual-pipeline:eval-suite:3.0.0",
  "title": "NEE post-runtime evidence-bound evaluation suite",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_id", "schema_version", "artifact_id", "canonical_digest", "suite_id", "pipeline", "execution_tier", "graph_sha256", "provider_posture", "runtime_boundary", "cases", "thresholds", "created_at", "extensions"],
  "properties": {
    "contract_id": {"const": "urn:nee:dual-pipeline:eval-suite:3.0.0"},
    "schema_version": {"const": "3.0.0"},
    "artifact_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "canonical_digest": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/canonicalDigest"},
    "suite_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "pipeline": {"type": "string", "enum": ["query", "ingestion", "dual"]},
    "execution_tier": {"type": "string", "enum": ["E0", "E1", "E2", "E3", "E4"]},
    "graph_sha256": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sha256"},
    "provider_posture": {"type": "string", "enum": ["none", "fake", "offline", "live_authorized"]},
    "runtime_boundary": {"const": "POST_RUNTIME_VERIFICATION"},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "urn:nee:dual-pipeline:eval-suite:3.0.0#/$defs/case"}},
    "thresholds": {"$ref": "urn:nee:dual-pipeline:eval-suite:3.0.0#/$defs/thresholds"},
    "created_at": {"type": "string", "format": "date-time"},
    "extensions": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/extensions"}
  },
  "$defs": {
    "queryExpected": {
      "allOf": [
        {"$ref": "urn:nee:dual-pipeline:eval-suite:1.0.0#/$defs/queryExpected"},
        {"type": "object", "required": ["expected_destination", "expected_assurance_profile", "expected_delivery_profile", "expected_artifact_type", "semantic_retrieval_qualified", "runtime_judge_receipt_required", "expected_runtime_quality_mode", "required_lanes", "required_requirement_assertions", "minimum_supported_requirement_count", "minimum_safe_direction_requirement_count", "minimum_connected_path_count"]}
      ]
    },
    "queryCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "pipeline", "tags", "critical", "evaluation_scope", "embedding_qualification", "question", "query_type", "classification", "audiences", "provider_posture", "expected"],
      "properties": {
        "case_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
        "pipeline": {"const": "query"},
        "tags": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 64}},
        "critical": {"type": "boolean"},
        "evaluation_scope": {"type": "string", "enum": ["graph_retrieval_qualification", "runtime_control_verification"]},
        "embedding_qualification": {"type": "string", "enum": ["real_bge_m3", "not_qualified"]},
        "question": {"type": "string", "minLength": 1, "maxLength": 4000},
        "query_type": {"type": "string", "enum": ["exact_lookup", "current_state", "current_state_corroboration", "project_status_current", "project_status_history", "relationship_explanation", "cross_workstream_synthesis", "gap_risk_inconsistency", "opportunity_nba", "candidate_promotion_review"]},
        "classification": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/classification"},
        "audiences": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/audiences"},
        "provider_posture": {"type": "string", "enum": ["none", "fake", "offline"]},
        "quality_control": {
          "type": "object", "additionalProperties": false, "required": ["mode", "judge_verdicts"],
          "properties": {
            "mode": {"type": "string", "enum": ["shadow", "enforced"]},
            "judge_verdicts": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"type": "string", "enum": ["PASS", "REPAIRABLE_FAIL", "ESCALATE_HITL", "ABSTAIN"]}}
          }
        },
        "expected": {"$ref": "urn:nee:dual-pipeline:eval-suite:3.0.0#/$defs/queryExpected"}
      }
    },
    "case": {
      "oneOf": [
        {"$ref": "urn:nee:dual-pipeline:eval-suite:3.0.0#/$defs/queryCase"},
        {"$ref": "urn:nee:dual-pipeline:eval-suite:1.0.0#/$defs/ingestionCase"}
      ]
    },
    "thresholds": {
      "allOf": [
        {"$ref": "urn:nee:dual-pipeline:eval-suite:1.0.0#/$defs/thresholds"},
        {"type": "object", "required": ["maximum_unqualified_retrieval_case_count"]}
      ]
    }
  }
}
