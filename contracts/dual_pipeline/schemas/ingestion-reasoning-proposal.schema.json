{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nee:dual-pipeline:ingestion-reasoning-proposal:1.0.0",
  "title": "NEE non-authoritative conditional-ingestion reasoning proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_id", "schema_version", "artifact_id", "canonical_digest", "proposal_id", "run_id", "trace_id", "decision_id", "packet_digest", "mode", "model_tier", "requested_model", "delivered_model", "reasoning_effort", "recommendations", "overall_review_priority", "summary_reason_codes", "authority_changes_proposed", "graph_operations_proposed", "canonical_approval_proposed", "created_at", "extensions"],
  "properties": {
    "contract_id": {"const": "urn:nee:dual-pipeline:ingestion-reasoning-proposal:1.0.0"},
    "schema_version": {"const": "1.0.0"},
    "artifact_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "canonical_digest": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/canonicalDigest"},
    "proposal_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "run_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "trace_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "decision_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "packet_digest": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sha256"},
    "mode": {"type": "string", "enum": ["shadow", "advisory"]},
    "model_tier": {"type": "string", "enum": ["normal", "high", "most_complex"]},
    "requested_model": {"type": "string", "minLength": 1},
    "delivered_model": {"type": "string", "minLength": 1},
    "reasoning_effort": {"type": "string", "enum": ["low", "medium", "high", "xhigh", "max"]},
    "recommendations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "recommendation", "evidence_ids", "reason_codes", "reviewer_question"],
        "properties": {
          "candidate_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
          "recommendation": {"type": "string", "enum": ["CANDIDATE", "QUARANTINE", "REJECTED_NOOP", "HITL_REQUIRED"]},
          "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"}},
          "reason_codes": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"}},
          "reviewer_question": {"type": ["string", "null"], "minLength": 1, "maxLength": 512}
        }
      }
    },
    "overall_review_priority": {"type": "string", "enum": ["low", "medium", "high"]},
    "summary_reason_codes": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"}},
    "authority_changes_proposed": {"const": false},
    "graph_operations_proposed": {"const": false},
    "canonical_approval_proposed": {"const": false},
    "created_at": {"type": "string", "format": "date-time"},
    "extensions": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/extensions"}
  }
}
