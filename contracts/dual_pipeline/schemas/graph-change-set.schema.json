{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nee:dual-pipeline:graph-change-set:1.0.0",
  "title": "NEE governed graph change set",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_id", "schema_version", "artifact_id", "canonical_digest", "change_set_id", "run_id", "trace_id", "status", "base_graph_snapshot", "base_graph_hash", "approval_id", "operations", "transaction_required", "rollback_required", "extensions"],
  "properties": {
    "contract_id": {"const": "urn:nee:dual-pipeline:graph-change-set:1.0.0"},
    "schema_version": {"const": "1.0.0"},
    "artifact_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "canonical_digest": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/canonicalDigest"},
    "change_set_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "run_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "trace_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "status": {"type": "string", "enum": ["proposed", "approved", "staged", "applied", "rolled_back"]},
    "base_graph_snapshot": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "base_graph_hash": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sha256"},
    "approval_id": {"type": ["string", "null"]},
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operation_id", "sequence", "operation", "target_type", "target_id", "before_state_hash", "after_state_hash", "evidence_ids", "classification", "audiences", "candidate_id"],
        "properties": {
          "operation_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
          "sequence": {"type": "integer", "minimum": 1},
          "operation": {"type": "string", "enum": ["create_entity", "add_alias", "add_source_version", "add_evidence", "add_candidate_assertion", "add_approved_assertion", "add_relationship", "supersede_assertion", "add_conflict_relation", "add_action_item", "update_lifecycle", "update_currentness"]},
          "target_type": {"type": "string", "enum": ["entity", "alias", "source_version", "evidence", "assertion", "relationship", "action_item"]},
          "target_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
          "before_state_hash": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sha256"},
          "after_state_hash": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sha256"},
          "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"}},
          "classification": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/classification"},
          "audiences": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/audiences"},
          "candidate_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"}
        }
      }
    },
    "transaction_required": {"const": true},
    "rollback_required": {"const": true},
    "extensions": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/extensions"}
  }
}
