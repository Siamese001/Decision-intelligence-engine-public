{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nee:dual-pipeline:l2-execution-decision:1.0.0",
  "title": "NEE deterministic post-retrieval L2 execution decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_id", "schema_version", "artifact_id", "canonical_digest", "decision_id", "run_id", "trace_id", "validated_request_digest", "query_plan_digest", "route_decision_digest", "evidence_packet_hash", "policy_config_digest", "required", "policy", "reason_code", "query_type", "route", "materiality", "initial_complexity", "final_complexity", "complexity_promotion_reasons", "selected_model_tier", "selected_model", "approved_evidence_count", "candidate_evidence_count", "external_public_evidence_count", "conflict_count", "gap_count", "graph_path_count", "estimated_prompt_size_chars", "output_contract_complexity", "provider_egress_allowed", "maximum_primary_calls", "maximum_repair_calls", "maximum_escalation_calls", "extensions"],
  "properties": {
    "contract_id": {"const": "urn:nee:dual-pipeline:l2-execution-decision:1.0.0"},
    "schema_version": {"const": "1.0.0"},
    "artifact_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "canonical_digest": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/canonicalDigest"},
    "decision_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "run_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "trace_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "validated_request_digest": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sha256"},
    "query_plan_digest": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sha256"},
    "route_decision_digest": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sha256"},
    "evidence_packet_hash": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sha256"},
    "policy_config_digest": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sha256"},
    "required": {"type": "boolean"},
    "policy": {"type": "string", "enum": ["forbidden", "conditional", "required"]},
    "reason_code": {"type": "string", "enum": ["EXACT_LOOKUP_DETERMINISTIC", "SIMPLE_CURRENT_STATE_DETERMINISTIC", "RELATIONSHIP_EXPLANATION_REQUIRED", "CROSS_WORKSTREAM_SYNTHESIS_REQUIRED", "GAP_OR_CONTRADICTION_REASONING_REQUIRED", "OPPORTUNITY_RECOMMENDATION_REQUIRED", "CANDIDATE_REVIEW_REASONING_REQUIRED", "MULTIPLE_MATERIAL_EVIDENCE_ITEMS", "MATERIAL_CONFLICT_PRESENT", "USER_REQUESTED_EXPLANATION", "USER_REQUESTED_COMPARISON", "USER_REQUESTED_RECOMMENDATION", "USER_REQUESTED_PRIORITIZATION", "USER_REQUESTED_DEFENSE_OR_RATIONALE", "NO_EVIDENCE_L2_NOT_USEFUL", "PROVIDER_EGRESS_NOT_AUTHORIZED", "OFFLINE_EXTERNAL_PROVIDER_FORBIDDEN"]},
    "query_type": {"type": "string", "enum": ["exact_lookup", "current_state", "current_state_corroboration", "project_status_current", "project_status_history", "relationship_explanation", "cross_workstream_synthesis", "gap_risk_inconsistency", "opportunity_nba", "candidate_promotion_review"]},
    "route": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/queryRoute"},
    "materiality": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/materiality"},
    "initial_complexity": {"type": "string", "enum": ["low", "normal", "high", "most_complex"]},
    "final_complexity": {"type": "string", "enum": ["low", "normal", "high", "most_complex"]},
    "complexity_promotion_reasons": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "selected_model_tier": {"type": ["string", "null"], "enum": ["normal", "high_materiality", "most_complex", null]},
    "selected_model": {"type": ["string", "null"]},
    "approved_evidence_count": {"type": "integer", "minimum": 0},
    "candidate_evidence_count": {"type": "integer", "minimum": 0},
    "external_public_evidence_count": {"type": "integer", "minimum": 0},
    "conflict_count": {"type": "integer", "minimum": 0},
    "gap_count": {"type": "integer", "minimum": 0},
    "graph_path_count": {"type": "integer", "minimum": 0},
    "estimated_prompt_size_chars": {"type": "integer", "minimum": 0},
    "output_contract_complexity": {"type": "string", "enum": ["standard", "high"]},
    "provider_egress_allowed": {"type": "boolean"},
    "maximum_primary_calls": {"type": "integer", "minimum": 0, "maximum": 1},
    "maximum_repair_calls": {"type": "integer", "minimum": 0, "maximum": 1},
    "maximum_escalation_calls": {"type": "integer", "minimum": 0, "maximum": 1},
    "extensions": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/extensions"}
  }
}
