{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nee:dual-pipeline:hitl-decision:1.0.0",
  "title": "NEE tiered HITL decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_id", "schema_version", "artifact_id", "canonical_digest", "decision_id", "review_item_id", "run_id", "trace_id", "tier", "decision", "reviewer", "decided_at", "rationale", "evidence_reviewed", "alternatives", "before_state_digest", "proposed_after_state_digest", "affected_candidate_ids", "challenger_required", "challenger_id", "extensions"],
  "properties": {
    "contract_id": {"const": "urn:nee:dual-pipeline:hitl-decision:1.0.0"},
    "schema_version": {"const": "1.0.0"},
    "artifact_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "canonical_digest": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/canonicalDigest"},
    "decision_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "review_item_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "run_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "trace_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "tier": {"type": "integer", "enum": [0, 1, 2]},
    "decision": {"type": "string", "enum": ["CONFIRM", "REJECT", "CREATE_NEW", "CREATE_EXTERNAL_CONCEPT", "ADD_ALIAS", "HOLD", "APPROVE_CANDIDATE", "PROMOTE_APPROVED", "QUARANTINE", "SUPERSEDE"]},
    "reviewer": {"type": "string", "minLength": 1},
    "decided_at": {"type": "string", "format": "date-time"},
    "rationale": {"type": "string", "minLength": 1, "maxLength": 4000},
    "evidence_reviewed": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"}},
    "alternatives": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "before_state_digest": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sha256"},
    "proposed_after_state_digest": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sha256"},
    "affected_candidate_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"}},
    "challenger_required": {"type": "boolean"},
    "challenger_id": {"type": ["string", "null"]},
    "extensions": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/extensions"}
  }
}
