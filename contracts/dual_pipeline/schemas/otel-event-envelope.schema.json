{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nee:dual-pipeline:otel-event-envelope:1.0.0",
  "title": "NEE sensitive-content-safe OpenTelemetry event envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_id", "schema_version", "artifact_id", "canonical_digest", "trace_id", "span_id", "parent_span_id", "span_name", "started_at", "ended_at", "status", "attributes", "extensions"],
  "properties": {
    "contract_id": {"const": "urn:nee:dual-pipeline:otel-event-envelope:1.0.0"},
    "schema_version": {"const": "1.0.0"},
    "artifact_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "canonical_digest": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/canonicalDigest"},
    "trace_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "span_id": {"type": "string", "pattern": "^[a-f0-9]{16}$"},
    "parent_span_id": {"type": ["string", "null"], "pattern": "^[a-f0-9]{16}$"},
    "span_name": {
      "type": "string",
      "enum": [
        "nee.uc1.u0.validate", "nee.uc1.l1.plan", "nee.uc1.l0.route", "nee.uc1.c0.entity_resolution", "nee.uc1.c0.semantic_compare", "nee.uc1.l2.decide", "nee.uc1.pa.assemble", "nee.uc1.l2.advise", "nee.uc1.x.exit", "nee.uc1.w0.graph_write", "nee.uc1.e0.index_build", "nee.uc1.l4.seal",
        "nee.uc2.u0.validate", "nee.uc2.l1.plan", "nee.uc2.l0.route", "nee.uc2.c0.exact", "nee.uc2.c0.hybrid", "nee.uc2.c0.graph_hydrate", "nee.uc2.l2.decide", "nee.uc2.pa.assemble", "nee.uc2.l2.reason", "nee.uc2.x.exit", "nee.uc2.l4.seal",
        "nee.hitl.h0.calibrate", "nee.hitl.h1.capture", "nee.hitl.h2.persist", "nee.hitl.h3.telemetry", "nee.hitl.l4.seal",
        "nee.learning.lp0.ingest_cluster", "nee.learning.lp1.propose", "nee.learning.lp2.simulate", "nee.learning.lp3.approve", "nee.learning.lp4.commit", "nee.learning.l4.seal"
      ]
    },
    "started_at": {"type": "string", "format": "date-time"},
    "ended_at": {"type": "string", "format": "date-time"},
    "status": {"type": "string", "enum": ["OK", "ERROR", "UNSET"]},
    "attributes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "use_case", "stage", "route", "lane", "decision_status", "model_id", "generation_id", "graph_snapshot", "input_digest", "output_digest", "record_count", "retry_count"],
      "properties": {
        "run_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
        "use_case": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/useCase"},
        "stage": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/stage"},
        "route": {"type": ["string", "null"]},
        "lane": {"type": ["string", "null"], "enum": ["approved", "candidate", "external_public", null]},
        "decision_status": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/status"},
        "model_id": {"type": ["string", "null"]},
        "generation_id": {"type": ["string", "null"]},
        "graph_snapshot": {"type": ["string", "null"]},
        "input_digest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "output_digest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "record_count": {"type": "integer", "minimum": 0},
        "retry_count": {"type": "integer", "minimum": 0},
        "query_type": {"type": ["string", "null"], "enum": ["exact_lookup", "current_state", "current_state_corroboration", "project_status_current", "project_status_history", "relationship_explanation", "cross_workstream_synthesis", "gap_risk_inconsistency", "opportunity_nba", "candidate_promotion_review", null]},
        "materiality": {"type": ["string", "null"], "enum": ["low", "medium", "high", null]},
        "assurance_profile": {"type": ["string", "null"], "enum": ["standard", "enhanced", null]},
        "initial_complexity": {"type": ["string", "null"], "enum": ["low", "normal", "high", "most_complex", null]},
        "final_complexity": {"type": ["string", "null"], "enum": ["low", "normal", "high", "most_complex", null]},
        "classification_source": {"type": ["string", "null"], "enum": ["operator_override", "deterministic", "classifier_llm", "policy_fallback", null]},
        "classifier_call_status": {"type": ["string", "null"], "enum": ["SKIPPED", "PASS", "FAILED", null]},
        "l2_policy": {"type": ["string", "null"], "enum": ["forbidden", "conditional", "required", "conditional_ingestion_advisory", null]},
        "l2_required": {"type": ["boolean", "null"]},
        "l2_reason_code": {"type": ["string", "null"], "enum": ["EXACT_LOOKUP_DETERMINISTIC", "SIMPLE_CURRENT_STATE_DETERMINISTIC", "RELATIONSHIP_EXPLANATION_REQUIRED", "CROSS_WORKSTREAM_SYNTHESIS_REQUIRED", "GAP_OR_CONTRADICTION_REASONING_REQUIRED", "OPPORTUNITY_RECOMMENDATION_REQUIRED", "CANDIDATE_REVIEW_REASONING_REQUIRED", "MULTIPLE_MATERIAL_EVIDENCE_ITEMS", "MATERIAL_CONFLICT_PRESENT", "USER_REQUESTED_EXPLANATION", "USER_REQUESTED_COMPARISON", "USER_REQUESTED_RECOMMENDATION", "USER_REQUESTED_PRIORITIZATION", "USER_REQUESTED_DEFENSE_OR_RATIONALE", "NO_EVIDENCE_L2_NOT_USEFUL", "PROVIDER_EGRESS_NOT_AUTHORIZED", "OFFLINE_EXTERNAL_PROVIDER_FORBIDDEN", "LOW_COMPLEXITY_DETERMINISTIC", "CONDITIONAL_MODEL_SELECTED", "RESTRICTED_EGRESS_FORBIDDEN", "POLICY_EGRESS_FORBIDDEN", null]},
        "selected_model_tier": {"type": ["string", "null"], "enum": ["normal", "high", "high_materiality", "most_complex", null]},
        "selected_model_profile": {"type": ["string", "null"], "enum": ["standard", "enhanced", null]},
        "selected_model": {"type": ["string", "null"]},
        "delivered_model_tier": {"type": ["string", "null"], "enum": ["normal", "high", "high_materiality", "most_complex", null]},
        "delivered_model_profile": {"type": ["string", "null"], "enum": ["standard", "enhanced", null]},
        "delivered_model": {"type": ["string", "null"]},
        "provider_egress_allowed": {"type": ["boolean", "null"]},
        "approved_evidence_count": {"type": ["integer", "null"], "minimum": 0},
        "candidate_evidence_count": {"type": ["integer", "null"], "minimum": 0},
        "external_public_evidence_count": {"type": ["integer", "null"], "minimum": 0},
        "conflict_count": {"type": ["integer", "null"], "minimum": 0},
        "gap_count": {"type": ["integer", "null"], "minimum": 0},
        "graph_path_count": {"type": ["integer", "null"], "minimum": 0},
        "call_purpose": {"type": ["string", "null"], "enum": ["PRIMARY", "SCHEMA_REPAIR", "QUALITY_ESCALATION", null]},
        "call_ordinal": {"type": ["integer", "null"], "minimum": 1},
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "cached_input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "uncached_input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "total_tokens": {"type": ["integer", "null"], "minimum": 0},
        "input_output_ratio": {"type": ["number", "null"], "minimum": 0},
        "cached_input_share": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "request_input_chars": {"type": ["integer", "null"], "minimum": 0},
        "request_schema_chars": {"type": ["integer", "null"], "minimum": 0},
        "request_serialized_chars": {"type": ["integer", "null"], "minimum": 0},
        "request_payload_digest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "budget_status": {"type": ["string", "null"], "enum": ["ALLOW", "BLOCK", "UNMEASURED", "NOT_APPLICABLE", null]},
        "budget_reason_code": {"type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_]{2,63}$"},
        "estimated_input_cost": {"type": ["number", "null"], "minimum": 0},
        "estimated_output_cost": {"type": ["number", "null"], "minimum": 0},
        "estimated_total_cost": {"type": ["number", "null"], "minimum": 0},
        "latency_ms": {"type": ["number", "null"], "minimum": 0},
        "disposition": {"type": ["string", "null"], "minLength": 1},
        "model_call_count": {"type": ["integer", "null"], "minimum": 0},
        "repair_call_count": {"type": ["integer", "null"], "minimum": 0},
        "escalation_call_count": {"type": ["integer", "null"], "minimum": 0},
        "judge_call_count": {"type": ["integer", "null"], "minimum": 0},
        "challenger_call_count": {"type": ["integer", "null"], "minimum": 0},
        "response_digest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "extensions": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/extensions"}
  }
}
