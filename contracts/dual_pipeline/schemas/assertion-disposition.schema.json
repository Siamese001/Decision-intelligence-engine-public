{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nee:dual-pipeline:assertion-disposition:1.0.0",
  "title": "NEE assertion disposition",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_id", "schema_version", "artifact_id", "canonical_digest", "disposition_id", "run_id", "trace_id", "candidate_id", "assertion_type", "disposition", "x3_outcome", "persistent_lane", "identity_resolved", "evidence_ids", "source_authority_sufficient", "currentness_valid", "classification_valid", "audience_valid", "material_contradiction_resolved", "hitl_required", "hitl_complete", "reason_codes", "decided_at", "extensions"],
  "properties": {
    "contract_id": {"const": "urn:nee:dual-pipeline:assertion-disposition:1.0.0"},
    "schema_version": {"const": "1.0.0"},
    "artifact_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "canonical_digest": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/canonicalDigest"},
    "disposition_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "run_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "trace_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "candidate_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "assertion_type": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/assertionType"},
    "disposition": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/disposition"},
    "x3_outcome": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/x3IntakeOutcome"},
    "persistent_lane": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/evidenceLane"},
    "identity_resolved": {"type": "boolean"},
    "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"}},
    "source_authority_sufficient": {"type": "boolean"},
    "currentness_valid": {"type": "boolean"},
    "classification_valid": {"type": "boolean"},
    "audience_valid": {"type": "boolean"},
    "material_contradiction_resolved": {"type": "boolean"},
    "hitl_required": {"type": "boolean"},
    "hitl_complete": {"type": "boolean"},
    "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "decided_at": {"type": "string", "format": "date-time"},
    "extensions": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/extensions"}
  }
}
