{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nee:dual-pipeline:uwg-runtime-evaluation:1.0.0",
  "title": "NEE Universal Write Gateway policy-bound candidate runtime evaluation",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_id", "schema_version", "artifact_id", "canonical_digest", "evaluation_id", "benchmark_id", "benchmark_digest", "benchmark_file_sha256", "origin_run_id", "candidate_pair", "candidate_assertion_ids", "case_results", "negative_results", "lane_isolation_results", "acl_results", "aggregate", "thresholds", "acceptance_policy", "status", "evaluated_at", "extensions"],
  "properties": {
    "contract_id": {"const": "urn:nee:dual-pipeline:uwg-runtime-evaluation:1.0.0"},
    "schema_version": {"const": "1.0.0"},
    "artifact_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "canonical_digest": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/canonicalDigest"},
    "evaluation_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "benchmark_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "benchmark_digest": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sha256"},
    "benchmark_file_sha256": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sha256"},
    "origin_run_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "candidate_pair": {"$ref": "urn:nee:dual-pipeline:uwg-runtime-evaluation:1.0.0#/$defs/pairBinding"},
    "candidate_assertion_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"}
    },
    "case_results": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "urn:nee:dual-pipeline:uwg-runtime-evaluation:1.0.0#/$defs/positiveResult"}
    },
    "negative_results": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "urn:nee:dual-pipeline:uwg-runtime-evaluation:1.0.0#/$defs/absenceResult"}
    },
    "lane_isolation_results": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "urn:nee:dual-pipeline:uwg-runtime-evaluation:1.0.0#/$defs/absenceResult"}
    },
    "acl_results": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "urn:nee:dual-pipeline:uwg-runtime-evaluation:1.0.0#/$defs/absenceResult"}
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recall_at_k", "mrr", "max_latency_ms", "negative_leakage_rate", "lane_leakage_rate", "acl_leakage_rate"],
      "properties": {
        "recall_at_k": {"type": "number", "minimum": 0, "maximum": 1},
        "mrr": {"type": "number", "minimum": 0, "maximum": 1},
        "max_latency_ms": {"type": "number", "minimum": 0},
        "negative_leakage_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "lane_leakage_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "acl_leakage_rate": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "thresholds": {"$ref": "urn:nee:dual-pipeline:uwg-benchmark:1.0.0#/$defs/thresholds"},
    "acceptance_policy": {"$ref": "urn:nee:dual-pipeline:uwg-benchmark:1.0.0#/$defs/policyBinding"},
    "status": {"type": "string", "enum": ["PASS", "FAIL"]},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "extensions": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/extensions"}
  },
  "$defs": {
    "positiveResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "expected_assertion_ids", "retrieved_assertion_ids", "first_relevant_rank", "recall_at_k", "reciprocal_rank", "latency_ms"],
      "properties": {
        "case_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
        "expected_assertion_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"}},
        "retrieved_assertion_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"}},
        "first_relevant_rank": {"type": ["integer", "null"], "minimum": 1},
        "recall_at_k": {"type": "number", "minimum": 0, "maximum": 1},
        "reciprocal_rank": {"type": "number", "minimum": 0, "maximum": 1},
        "latency_ms": {"type": "number", "minimum": 0}
      }
    },
    "absenceResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "lane", "forbidden_assertion_ids", "retrieved_assertion_ids", "violating_assertion_ids", "pass", "latency_ms"],
      "properties": {
        "case_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
        "lane": {"type": "string", "enum": ["approved", "candidate"]},
        "forbidden_assertion_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"}},
        "retrieved_assertion_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"}},
        "violating_assertion_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"}},
        "pass": {"type": "boolean"},
        "latency_ms": {"type": "number", "minimum": 0}
      }
    },
    "pairBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation_id", "graph_snapshot", "graph_sha256", "sidecar_sha256", "embedding_backend", "model_id", "model_revision", "model_manifest_digest", "production_qualified"],
      "properties": {
        "generation_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
        "graph_snapshot": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
        "graph_sha256": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sha256"},
        "sidecar_sha256": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sha256"},
        "embedding_backend": {"type": "string", "minLength": 1},
        "model_id": {"type": "string", "minLength": 1},
        "model_revision": {"type": "string", "minLength": 1},
        "model_manifest_digest": {"type": ["string", "null"], "minLength": 1},
        "production_qualified": {"type": "boolean"}
      }
    }
  }
}
