{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nee:dual-pipeline:agent-autonomy-contract:1.0.0",
  "title": "NEE Agent Autonomy & Delegation Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "schema_version",
    "task_id",
    "parent_task_id",
    "agent_role",
    "objective",
    "scope_in",
    "scope_out",
    "allowed_tools",
    "deliverable",
    "definition_of_done",
    "reasoning_tier",
    "budget",
    "escalation_rule"
  ],
  "properties": {
    "contract_id": {
      "const": "urn:nee:dual-pipeline:agent-autonomy-contract:1.0.0"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "parent_task_id": {
      "type": "string",
      "minLength": 1
    },
    "agent_role": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "scope_in": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "scope_out": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowed_tools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deliverable": {
      "type": ["string", "object"],
      "description": "Expected deliverable artifact file path or structural spec"
    },
    "definition_of_done": {
      "type": "string",
      "minLength": 1
    },
    "reasoning_tier": {
      "type": "string",
      "enum": [
        "FRONTIER_HIGH_REASONING",
        "MID_TIER_REASONING",
        "STANDARD_FAST",
        "LOCAL_METAL"
      ]
    },
    "reasoning_effort": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_tool_calls": {
          "type": "integer",
          "minimum": 1
        },
        "max_retries": {
          "type": "integer",
          "minimum": 0
        },
        "token_limit": {
          "type": "integer",
          "minimum": 1
        }
      },
      "minProperties": 1
    },
    "escalation_rule": {
      "type": "string",
      "minLength": 1
    },
    "ambiguity_threshold": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "default": 0.30
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
