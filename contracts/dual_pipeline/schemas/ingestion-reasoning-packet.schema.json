{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nee:dual-pipeline:ingestion-reasoning-packet:1.0.0",
  "title": "NEE sealed minimized conditional-ingestion reasoning packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_id", "schema_version", "artifact_id", "canonical_digest", "packet_id", "run_id", "trace_id", "decision_id", "decision_digest", "source_id", "source_version_id", "evidence_ids", "candidates", "source_bound_only", "raw_source_included", "governed_context_digest", "created_at", "extensions"],
  "properties": {
    "contract_id": {"const": "urn:nee:dual-pipeline:ingestion-reasoning-packet:1.0.0"},
    "schema_version": {"const": "1.0.0"},
    "artifact_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "canonical_digest": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/canonicalDigest"},
    "packet_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "run_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "trace_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "decision_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "decision_digest": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sha256"},
    "source_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "source_version_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"}},
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "candidate_type", "materiality", "normalized_text", "evidence_ids", "classification", "intake_route", "entity_resolution_outcomes", "exact_record_ids", "semantic_matches"],
        "properties": {
          "candidate_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
          "candidate_type": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/candidateType"},
          "materiality": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/materiality"},
          "normalized_text": {"type": "string", "minLength": 1, "maxLength": 4000},
          "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"}},
          "classification": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/classification"},
          "intake_route": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/intakeRoute"},
          "entity_resolution_outcomes": {"type": "array", "uniqueItems": true, "items": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/entityResolutionOutcome"}},
          "exact_record_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"}},
          "semantic_matches": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["record_id", "lane", "score"],
              "properties": {
                "record_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
                "lane": {"type": "string", "enum": ["approved", "candidate"]},
                "score": {"type": "number", "minimum": 0}
              }
            }
          }
        }
      }
    },
    "source_bound_only": {"const": true},
    "raw_source_included": {"const": false},
    "governed_context_digest": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sha256"},
    "created_at": {"type": "string", "format": "date-time"},
    "extensions": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/extensions"}
  }
}
