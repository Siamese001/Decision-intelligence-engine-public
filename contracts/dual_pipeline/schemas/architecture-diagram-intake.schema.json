{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nee:dual-pipeline:architecture-diagram-intake:1.0.0",
  "title": "NEE architecture diagram intake package",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_id", "schema_version", "artifact_id", "canonical_digest", "source", "components", "relationships", "open_ambiguities", "extensions"],
  "properties": {
    "contract_id": {"const": "urn:nee:dual-pipeline:architecture-diagram-intake:1.0.0"},
    "schema_version": {"const": "1.0.0"},
    "artifact_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "canonical_digest": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/canonicalDigest"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_version_id", "file_hash", "diagram_id", "page_id", "version", "source_date", "classification", "audiences"],
      "properties": {
        "source_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
        "source_version_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
        "file_hash": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sha256"},
        "diagram_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
        "page_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "source_date": {"type": "string", "format": "date"},
        "classification": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/classification"},
        "audiences": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/audiences"}
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component_ref", "reported_label", "candidate_type", "region", "extraction_confidence"],
        "properties": {
          "component_ref": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
          "reported_label": {"type": "string", "minLength": 1},
          "candidate_type": {"type": "string", "minLength": 1},
          "region": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sourceLocator"},
          "extraction_confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relationship_ref", "from_component_ref", "reported_predicate", "to_component_ref", "region", "extraction_confidence"],
        "properties": {
          "relationship_ref": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
          "from_component_ref": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
          "reported_predicate": {"type": "string", "minLength": 1},
          "to_component_ref": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
          "region": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sourceLocator"},
          "extraction_confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "open_ambiguities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ambiguity_id", "description", "affected_refs", "region", "recommended_exit"],
        "properties": {
          "ambiguity_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
          "description": {"type": "string", "minLength": 1},
          "affected_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"}},
          "region": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sourceLocator"},
          "recommended_exit": {"type": "string", "enum": ["HITL_CONFIRM_ENTITY", "HITL_CONFIRM_RELATIONSHIP", "QUARANTINE"]}
        }
      }
    },
    "extensions": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/extensions"}
  }
}
