{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nee:dual-pipeline:active-ingestion-completion-receipt:1.0.0",
  "title": "Active Ingestion Completion Receipt",
  "description": "Sealed completion receipt proving active knowledge graph publication, activation, and verified source coverage.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "schema_version",
    "artifact_id",
    "receipt_id",
    "run_id",
    "directive_id",
    "runtime_root",
    "completion_status",
    "active_generation",
    "before_generation",
    "graph_sha256",
    "before_graph_sha256",
    "delta_table_counts",
    "source_coverage_verified",
    "readback_evidence_ids",
    "release_receipt_digest",
    "activation_receipt_digest",
    "retrieval_qualification_status",
    "completed_at",
    "extensions",
    "canonical_digest"
  ],
  "properties": {
    "contract_id": {
      "const": "urn:nee:dual-pipeline:active-ingestion-completion-receipt:1.0.0"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "artifact_id": {
      "$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"
    },
    "receipt_id": {
      "$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"
    },
    "run_id": {
      "$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"
    },
    "directive_id": {
      "$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"
    },
    "runtime_root": {
      "type": "string"
    },
    "completion_status": {
      "type": "string",
      "enum": [
        "COMPLETE_UPDATED",
        "COMPLETE_ALREADY_PRESENT"
      ]
    },
    "active_generation": {
      "type": "integer",
      "minimum": 0
    },
    "before_generation": {
      "type": "integer",
      "minimum": 0
    },
    "graph_sha256": {
      "$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sha256"
    },
    "before_graph_sha256": {
      "$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sha256"
    },
    "delta_table_counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "source_coverage_verified": {
      "const": true
    },
    "readback_evidence_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "release_receipt_digest": {
      "$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sha256"
    },
    "activation_receipt_digest": {
      "$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sha256"
    },
    "retrieval_qualification_status": {
      "type": "string",
      "enum": [
        "PASSED",
        "EXEMPT"
      ]
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "extensions": {
      "$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/extensions"
    },
    "canonical_digest": {
      "$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/canonicalDigest"
    }
  }
}
