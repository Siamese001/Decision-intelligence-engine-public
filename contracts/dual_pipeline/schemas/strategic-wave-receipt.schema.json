{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nee:dual-pipeline:strategic-wave-receipt:1.0.0",
  "title": "NEE strategic reasoning implementation wave receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_id", "schema_version", "artifact_id", "canonical_digest", "receipt_id", "program_id", "wave_number", "wave_name", "status", "prior_receipt_digest", "evidence", "gates", "graph_sha256_before", "graph_sha256_after", "provider_call_count", "model_call_count", "graph_mutation_count", "index_mutation_count", "active_pair_mutation_count", "activation_state", "completed_at", "extensions"],
  "properties": {
    "contract_id": {"const": "urn:nee:dual-pipeline:strategic-wave-receipt:1.0.0"},
    "schema_version": {"const": "1.0.0"},
    "artifact_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "canonical_digest": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/canonicalDigest"},
    "receipt_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "program_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "wave_number": {"type": "integer", "minimum": 1, "maximum": 8},
    "wave_name": {"type": "string", "minLength": 3},
    "status": {"type": "string", "enum": ["PASS", "FAIL", "BLOCKED"]},
    "prior_receipt_digest": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sha256"}
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "reference", "sha256"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "enum": ["contract", "fixture", "test", "analysis", "artifact", "runtime_boundary"]},
          "reference": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sha256"}
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate_id", "status", "detail"],
        "properties": {
          "gate_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
          "status": {"type": "string", "enum": ["PASS", "FAIL", "BLOCKED"]},
          "detail": {"type": "string", "minLength": 1}
        }
      }
    },
    "graph_sha256_before": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sha256"},
    "graph_sha256_after": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sha256"},
    "provider_call_count": {"const": 0},
    "model_call_count": {"const": 0},
    "graph_mutation_count": {"const": 0},
    "index_mutation_count": {"const": 0},
    "active_pair_mutation_count": {"const": 0},
    "activation_state": {"type": "string", "enum": ["NOT_APPLICABLE", "READY_NOT_ACTIVATED", "ACTIVATED"]},
    "completed_at": {"type": "string", "format": "date-time"},
    "extensions": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/extensions"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "PASS"}}, "required": ["status"]},
      "then": {"properties": {"gates": {"items": {"properties": {"status": {"const": "PASS"}}}}}}
    },
    {
      "if": {"properties": {"wave_number": {"const": 8}}, "required": ["wave_number"]},
      "then": {"properties": {"activation_state": {"const": "READY_NOT_ACTIVATED"}}}
    }
  ]
}
