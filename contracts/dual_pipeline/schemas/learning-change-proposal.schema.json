{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nee:dual-pipeline:learning-change-proposal:1.0.0",
  "title": "NEE approval-required learning change proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_id", "schema_version", "artifact_id", "canonical_digest", "proposal_id", "run_ids", "proposal_type", "status", "problem", "evidence_event_ids", "proposed_change", "evaluation_plan", "risk", "approval_required", "auto_apply", "created_at", "extensions"],
  "properties": {
    "contract_id": {"const": "urn:nee:dual-pipeline:learning-change-proposal:1.0.0"},
    "schema_version": {"const": "1.0.0"},
    "artifact_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "canonical_digest": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/canonicalDigest"},
    "proposal_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "run_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"}},
    "proposal_type": {"type": "string", "enum": ["alias_addition", "extraction_template", "source_authority_policy", "threshold", "prompt", "routing", "retrieval_weight", "workflow", "benchmark_case", "hitl_confidence", "copilot_context", "copilot_grounding", "query_retrieval"]},
    "status": {"const": "proposed"},
    "problem": {"type": "string", "minLength": 1},
    "evidence_event_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"}},
    "proposed_change": {"type": "string", "minLength": 1},
    "evaluation_plan": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "risk": {"type": "string", "enum": ["low", "medium", "high"]},
    "approval_required": {"const": true},
    "auto_apply": {"const": false},
    "created_at": {"type": "string", "format": "date-time"},
    "extensions": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/extensions"}
  }
}
