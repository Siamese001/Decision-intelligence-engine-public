{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nee:dual-pipeline:eval-comparison:2.0.0",
  "title": "NEE controlled measured workflow evaluation comparison",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_id", "schema_version", "artifact_id", "canonical_digest", "comparison_id", "baseline_evaluation_id", "baseline_digest", "candidate_evaluation_id", "candidate_digest", "suite_id", "invariant_bindings_digest", "declared_treatment_differences", "metric_deltas", "credit_improvement_fraction", "minimum_credit_improvement_fraction", "status", "cause_codes", "compared_at", "extensions"],
  "properties": {
    "contract_id": {"const": "urn:nee:dual-pipeline:eval-comparison:2.0.0"},
    "schema_version": {"const": "2.0.0"},
    "artifact_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "canonical_digest": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/canonicalDigest"},
    "comparison_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "baseline_evaluation_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "baseline_digest": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sha256"},
    "candidate_evaluation_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "candidate_digest": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sha256"},
    "suite_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "invariant_bindings_digest": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sha256"},
    "declared_treatment_differences": {"$ref": "urn:nee:dual-pipeline:eval-comparison:2.0.0#/$defs/treatmentDifferences"},
    "metric_deltas": {"type": "array", "minItems": 1, "items": {"$ref": "urn:nee:dual-pipeline:eval-comparison:2.0.0#/$defs/metricDelta"}},
    "credit_improvement_fraction": {"type": "number"},
    "minimum_credit_improvement_fraction": {"type": "number", "minimum": 0, "maximum": 1},
    "status": {"type": "string", "enum": ["PASS", "FAIL", "NOT_COMPARABLE"]},
    "cause_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,127}$"}},
    "compared_at": {"type": "string", "format": "date-time"},
    "extensions": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/extensions"}
  },
  "$defs": {
    "treatment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["treatment_id", "history_policy", "tool_output_policy", "budget_enforced", "no_progress_limit", "feature_path"],
      "properties": {
        "treatment_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
        "history_policy": {"type": "string", "enum": ["bounded", "append_completed"]},
        "tool_output_policy": {"type": "string", "enum": ["externalize", "inline"]},
        "budget_enforced": {"type": "boolean"},
        "no_progress_limit": {"type": "integer", "minimum": 1, "maximum": 20},
        "feature_path": {"type": "string", "enum": ["candidate", "legacy"]}
      }
    },
    "treatmentDifferences": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "candidate"],
      "properties": {
        "baseline": {"$ref": "urn:nee:dual-pipeline:eval-comparison:2.0.0#/$defs/treatment"},
        "candidate": {"$ref": "urn:nee:dual-pipeline:eval-comparison:2.0.0#/$defs/treatment"}
      }
    },
    "metricDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "baseline", "candidate", "delta", "direction", "tolerance", "regression"],
      "properties": {
        "metric": {"type": "string", "minLength": 1, "maxLength": 128},
        "baseline": {"type": "number"},
        "candidate": {"type": "number"},
        "delta": {"type": "number"},
        "direction": {"const": "lower"},
        "tolerance": {"type": "number", "minimum": 0},
        "regression": {"type": "boolean"}
      }
    }
  }
}
