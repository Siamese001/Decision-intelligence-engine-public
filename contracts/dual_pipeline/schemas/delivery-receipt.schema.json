{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nee:dual-pipeline:delivery-receipt:1.0.0",
  "title": "NEE grounded delivery certification receipt",
  "description": "Seals final verification of delivery content against structured claims and GraphDB runtime snapshot.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "schema_version",
    "artifact_id",
    "receipt_id",
    "manifest_id",
    "manifest_digest",
    "payload_digest",
    "runtime_root",
    "graph_generation_id",
    "graph_sha256",
    "status",
    "reason_code",
    "total_claims_count",
    "supported_claims_count",
    "contradicted_claims_count",
    "delivery_surface",
    "audience",
    "word_count",
    "certified_at",
    "canonical_digest",
    "extensions"
  ],
  "properties": {
    "contract_id": {"const": "urn:nee:dual-pipeline:delivery-receipt:1.0.0"},
    "schema_version": {"const": "1.0.0"},
    "artifact_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "receipt_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "manifest_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "manifest_digest": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sha256"},
    "payload_digest": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sha256"},
    "runtime_root": {"type": "string"},
    "graph_generation_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "graph_sha256": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sha256"},
    "status": {
      "type": "string",
      "enum": ["CERTIFIED", "REJECTED", "BLOCKED"]
    },
    "reason_code": {
      "type": "string",
      "enum": [
        "GROUNDED_SUPPORTED",
        "UNSUPPORTED_CLAIM",
        "AMBIGUOUS_IDENTITY",
        "UNRESOLVED_CONTRADICTION",
        "SUPERSEDED_EVIDENCE",
        "INACCESSIBLE_AUDIENCE",
        "GENERATION_DRIFT",
        "WORD_COUNT_EXCEEDED",
        "ZERO_GRAPH_TRAVERSAL",
        "PROMPT_ECHO_CONTAMINATION",
        "CROSS_SPEAKER_PROMPT_ECHO",
        "UNANCHORED_PLACEHOLDER_CLAIM",
        "UNBACKED_PAYLOAD_SPAN"
      ]
    },
    "total_claims_count": {"type": "integer", "minimum": 0},
    "supported_claims_count": {"type": "integer", "minimum": 0},
    "contradicted_claims_count": {"type": "integer", "minimum": 0},
    "delivery_surface": {"type": "string"},
    "audience": {"type": "string"},
    "word_count": {"type": "integer", "minimum": 0},
    "certified_at": {"type": "string", "format": "date-time"},
    "canonical_digest": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/canonicalDigest"},
    "extensions": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/extensions"}
  }
}
