{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nee:dual-pipeline:eval-bridge-suite:1.0.0",
  "title": "NEE same-runtime ingestion-to-query bridge evaluation suite",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_id", "schema_version", "artifact_id", "canonical_digest", "suite_id", "graph_sha256", "cases", "thresholds", "created_at", "extensions"],
  "properties": {
    "contract_id": {"const": "urn:nee:dual-pipeline:eval-bridge-suite:1.0.0"},
    "schema_version": {"const": "1.0.0"},
    "artifact_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "canonical_digest": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/canonicalDigest"},
    "suite_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "graph_sha256": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sha256"},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "urn:nee:dual-pipeline:eval-bridge-suite:1.0.0#/$defs/case"}},
    "thresholds": {"$ref": "urn:nee:dual-pipeline:eval-bridge-suite:1.0.0#/$defs/thresholds"},
    "created_at": {"type": "string", "format": "date-time"},
    "extensions": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/extensions"}
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "tags", "package_path", "package_sha256", "intake_audiences", "question", "query_type", "classification", "audiences", "expected_source_terms"],
      "properties": {
        "case_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
        "tags": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 64}},
        "package_path": {"type": "string", "minLength": 1, "maxLength": 512},
        "package_sha256": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sha256"},
        "intake_audiences": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/audiences"},
        "question": {"type": "string", "minLength": 1, "maxLength": 4000},
        "query_type": {"type": "string", "enum": ["candidate_promotion_review"]},
        "classification": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/classification"},
        "audiences": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/audiences"},
        "expected_source_terms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 3, "maxLength": 256}}
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximum_provider_call_count", "maximum_graph_mutation_count"],
      "properties": {
        "maximum_provider_call_count": {"type": "integer", "minimum": 0, "maximum": 100},
        "maximum_graph_mutation_count": {"type": "integer", "minimum": 1, "maximum": 1000}
      }
    }
  }
}
