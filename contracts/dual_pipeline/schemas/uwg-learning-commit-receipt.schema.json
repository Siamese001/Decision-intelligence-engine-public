{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nee:dual-pipeline:uwg-learning-commit-receipt:1.0.0",
  "title": "NEE Universal Write Gateway learning parameter commit receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "schema_version",
    "artifact_id",
    "canonical_digest",
    "commit_id",
    "commit_type",
    "proposal_id",
    "proposal_digest",
    "approval_receipt_id",
    "applied_by",
    "applied_at",
    "status",
    "applied_parameters",
    "previous_parameters",
    "rollback_receipt_id",
    "active_pair_binding",
    "graph_delta_counts",
    "extensions"
  ],
  "properties": {
    "contract_id": {"const": "urn:nee:dual-pipeline:uwg-learning-commit-receipt:1.0.0"},
    "schema_version": {"const": "1.0.0"},
    "artifact_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "canonical_digest": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/canonicalDigest"},
    "commit_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "commit_type": {"const": "learning_parameter_commit"},
    "proposal_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "proposal_digest": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sha256"},
    "approval_receipt_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "applied_by": {"type": "string", "minLength": 1, "maxLength": 256},
    "applied_at": {"type": "string", "format": "date-time"},
    "status": {"type": "string", "enum": ["APPLIED", "ROLLED_BACK"]},
    "applied_parameters": {"type": "object", "additionalProperties": true},
    "previous_parameters": {"type": "object", "additionalProperties": true},
    "rollback_receipt_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "active_pair_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation_id", "graph_sha256"],
      "properties": {
        "generation_id": {"type": "string", "minLength": 1},
        "graph_sha256": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sha256"}
      }
    },
    "graph_delta_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "assertion", "evidence_item", "total_delta"],
      "properties": {
        "node": {"type": "integer", "const": 0},
        "assertion": {"type": "integer", "const": 0},
        "evidence_item": {"type": "integer", "const": 0},
        "total_delta": {"type": "integer", "const": 0}
      }
    },
    "extensions": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/extensions"}
  }
}
