{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nee:dual-pipeline:query-coverage-manifest:1.0.0",
  "title": "NEE sealed query coverage manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_id", "schema_version", "artifact_id", "canonical_digest", "manifest_id", "run_id", "validated_request_digest", "query_plan_digest", "graph_snapshot", "graph_sha256", "authorization_scope_digest", "requirements", "extensions"],
  "properties": {
    "contract_id": {"const": "urn:nee:dual-pipeline:query-coverage-manifest:1.0.0"},
    "schema_version": {"const": "1.0.0"},
    "artifact_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "canonical_digest": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/canonicalDigest"},
    "manifest_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "run_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "validated_request_digest": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sha256"},
    "query_plan_digest": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sha256"},
    "graph_snapshot": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "graph_sha256": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sha256"},
    "authorization_scope_digest": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sha256"},
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "urn:nee:dual-pipeline:query-coverage-manifest:1.0.0#/$defs/requirement"}
    },
    "extensions": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/extensions"}
  },
  "$defs": {
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement_id", "requirement_label", "requirement_kind", "allowed_lanes", "missing_evidence_disposition", "materiality"],
      "properties": {
        "requirement_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
        "requirement_label": {"type": "string", "minLength": 1, "maxLength": 512},
        "requirement_kind": {"type": "string", "enum": ["named_subject", "relationship", "comparison", "evidence", "conclusion", "policy_requirement", "graph_facet"]},
        "allowed_lanes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "enum": ["approved", "candidate", "external_public"]}},
        "missing_evidence_disposition": {"type": "string", "enum": ["explicit_gap", "escalate_hitl", "block"]},
        "materiality": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/materiality"}
      }
    }
  }
}
