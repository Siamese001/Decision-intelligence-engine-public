{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nee:dual-pipeline:ingestion-reasoning-decision:1.0.0",
  "title": "NEE deterministic conditional-ingestion reasoning decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_id", "schema_version", "artifact_id", "canonical_digest", "decision_id", "run_id", "trace_id", "mode", "bundle_digest", "plan_digest", "resolution_digest", "comparison_digest", "governed_context_digest", "route_digest", "policy_config_digest", "initial_complexity", "final_complexity", "promotion_reasons", "call_selected", "reason_code", "selected_model_tier", "selected_model", "reasoning_effort", "provider_egress_allowed", "candidate_count", "entity_mention_count", "ambiguous_identity_count", "semantic_match_count", "estimated_prompt_size_chars", "maximum_primary_calls", "maximum_repair_calls", "maximum_escalation_calls", "decided_at", "extensions"],
  "properties": {
    "contract_id": {"const": "urn:nee:dual-pipeline:ingestion-reasoning-decision:1.0.0"},
    "schema_version": {"const": "1.0.0"},
    "artifact_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "canonical_digest": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/canonicalDigest"},
    "decision_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "run_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "trace_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "mode": {"type": "string", "enum": ["shadow", "advisory"]},
    "bundle_digest": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sha256"},
    "plan_digest": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sha256"},
    "resolution_digest": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sha256"},
    "comparison_digest": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sha256"},
    "governed_context_digest": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sha256"},
    "route_digest": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sha256"},
    "policy_config_digest": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sha256"},
    "initial_complexity": {"type": "string", "enum": ["low", "normal", "high", "most_complex"]},
    "final_complexity": {"type": "string", "enum": ["low", "normal", "high", "most_complex"]},
    "promotion_reasons": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "call_selected": {"type": "boolean"},
    "reason_code": {"type": "string", "enum": ["LOW_COMPLEXITY_DETERMINISTIC", "CONDITIONAL_MODEL_SELECTED", "RESTRICTED_EGRESS_FORBIDDEN", "POLICY_EGRESS_FORBIDDEN"]},
    "selected_model_tier": {"type": ["string", "null"], "enum": ["normal", "high", "most_complex", null]},
    "selected_model": {"type": ["string", "null"], "minLength": 1},
    "reasoning_effort": {"type": ["string", "null"], "enum": ["low", "medium", "high", "xhigh", "max", null]},
    "provider_egress_allowed": {"type": "boolean"},
    "candidate_count": {"type": "integer", "minimum": 1},
    "entity_mention_count": {"type": "integer", "minimum": 0},
    "ambiguous_identity_count": {"type": "integer", "minimum": 0},
    "semantic_match_count": {"type": "integer", "minimum": 0},
    "estimated_prompt_size_chars": {"type": "integer", "minimum": 0},
    "maximum_primary_calls": {"const": 1},
    "maximum_repair_calls": {"const": 1},
    "maximum_escalation_calls": {"const": 0},
    "decided_at": {"type": "string", "format": "date-time"},
    "extensions": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/extensions"}
  }
}
