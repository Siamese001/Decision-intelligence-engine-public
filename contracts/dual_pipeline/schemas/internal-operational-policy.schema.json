{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nee:dual-pipeline:internal-operational-policy:1.0.0",
  "title": "NEE trusted-team internal operational policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_id", "schema_version", "artifact_id", "canonical_digest", "policy_id", "policy_version", "status", "owner", "assurance_tier", "deployment_scope", "authorization_mode", "allowed_audiences", "allowed_classifications", "allowed_backends", "model_binding", "controls", "qualification_thresholds", "extensions"],
  "properties": {
    "contract_id": {"const": "urn:nee:dual-pipeline:internal-operational-policy:1.0.0"},
    "schema_version": {"const": "1.0.0"},
    "artifact_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "canonical_digest": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/canonicalDigest"},
    "policy_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "policy_version": {"type": "string", "minLength": 1},
    "status": {"const": "CONFIGURED"},
    "owner": {"type": "string", "minLength": 1},
    "assurance_tier": {"const": "internal_operational"},
    "deployment_scope": {"const": "local_team"},
    "authorization_mode": {"const": "internal_operator_policy"},
    "allowed_audiences": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "allowed_classifications": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "enum": ["public", "internal", "confidential"]}},
    "allowed_backends": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"const": "flagembedding-bge-m3-internal"}},
    "model_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "model_revision", "model_manifest_digest"],
      "properties": {
        "model_id": {"const": "BAAI/bge-m3"},
        "model_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "model_manifest_digest": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sha256"}
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["autonomous_graph_writes_allowed", "manual_hitl_required", "terminal_directive_required", "sealed_e3_evaluation_required", "backup_restore_required", "legacy_debt_policy", "ingestion_provider_call_limit", "query_provider_egress_default"],
      "properties": {
        "autonomous_graph_writes_allowed": {"const": false},
        "manual_hitl_required": {"const": true},
        "terminal_directive_required": {"const": true},
        "sealed_e3_evaluation_required": {"const": true},
        "backup_restore_required": {"const": true},
        "legacy_debt_policy": {"const": "no_regression"},
        "ingestion_provider_call_limit": {"const": 0},
        "query_provider_egress_default": {"const": false}
      }
    },
    "qualification_thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_case_latency_ms", "max_forbidden_leakage_count", "require_all_hybrid_components", "require_all_suite_cases"],
      "properties": {
        "max_case_latency_ms": {"type": "number", "minimum": 1},
        "max_forbidden_leakage_count": {"const": 0},
        "require_all_hybrid_components": {"const": true},
        "require_all_suite_cases": {"const": true}
      }
    },
    "extensions": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/extensions"}
  }
}
