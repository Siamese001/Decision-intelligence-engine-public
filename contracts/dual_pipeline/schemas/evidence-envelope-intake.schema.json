{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nee:dual-pipeline:evidence-envelope-intake:1.0.0",
  "title": "NEE unified Evidence Envelope intake package",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_id", "schema_version", "artifact_id", "canonical_digest", "meeting", "speakers", "actions", "adapter", "extensions"],
  "properties": {
    "contract_id": {
      "enum": [
        "urn:nee:dual-pipeline:evidence-envelope-intake:1.0.0",
        "urn:nee:dual-pipeline:google-meet-gemini-intake:1.0.0"
      ]
    },
    "schema_version": {"const": "1.0.0"},
    "artifact_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "canonical_digest": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/canonicalDigest"},
    "meeting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["meeting_id", "title", "attendees", "source_location", "source_hash", "template_version", "classification", "audiences"],
      "properties": {
        "meeting_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
        "title": {"type": "string", "minLength": 1, "maxLength": 256},
        "started_at": {"type": ["string", "null"]},
        "organizer": {"type": ["string", "null"]},
        "attendees": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "platform_reference": {"type": ["string", "null"]},
        "google_meet_reference": {"type": ["string", "null"]},
        "teams_reference": {"type": ["string", "null"]},
        "source_location": {"type": "string", "minLength": 1},
        "transcript_reference": {"type": ["string", "null"]},
        "recording_reference": {"type": ["string", "null"]},
        "source_hash": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sha256"},
        "template_version": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){0,2}$"},
        "classification": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/classification"},
        "audiences": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/audiences"}
      }
    },
    "speakers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["speaker_ref", "reported_name", "email", "role_or_org", "statements"],
        "properties": {
          "speaker_ref": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
          "reported_name": {"type": ["string", "null"]},
          "email": {"type": ["string", "null"], "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"},
          "role_or_org": {"type": ["string", "null"]},
          "statements": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["statement_id", "kind", "text", "locator", "gemini_confidence"],
              "properties": {
                "statement_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
                "kind": {"type": "string", "enum": ["summary", "decision", "risk", "dependency", "technical", "strategic"]},
                "text": {"type": "string", "minLength": 1, "maxLength": 4000},
                "locator": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sourceLocator"},
                "gemini_confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
              }
            }
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action_id", "reported_owner", "action", "due_date", "status", "dependency", "requested_follow_up", "locator"],
        "properties": {
          "action_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
          "reported_owner": {"type": ["string", "null"]},
          "action": {"type": "string", "minLength": 1, "maxLength": 2000},
          "due_date": {"type": ["string", "null"], "format": "date"},
          "status": {"type": "string", "enum": ["open", "planned", "completed", "cancelled"]},
          "dependency": {"type": ["string", "null"]},
          "requested_follow_up": {"type": ["string", "null"]},
          "locator": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sourceLocator"}
        }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "enum": [
            "nee-evidence-envelope-intake",
            "nee-google-meet-gemini-intake",
            "nee-copilot-intake",
            "nee-visual-document-intake"
          ]
        },
        "version": {"const": "1.0.0"}
      }
    },
    "extensions": {
      "allOf": [
        {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/extensions"},
        {
          "properties": {
            "source.profile": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "profile_version",
                "source_id",
                "semantic_family",
                "media_modality",
                "container_type",
                "classification_basis",
                "authority_rank"
              ],
              "properties": {
                "profile_version": {"type": "string"},
                "source_id": {"type": "string"},
                "semantic_family": {
                  "type": "string",
                  "enum": [
                    "raw_transcript",
                    "derived_record",
                    "correspondence",
                    "commercial_contract",
                    "working_source",
                    "visual_collateral",
                    "research_intelligence",
                    "structured_operational",
                    "mixed",
                    "unknown"
                  ]
                },
                "media_modality": {
                  "type": "string",
                  "enum": ["audio", "text", "visual", "structured", "document", "multimodal"]
                },
                "container_type": {"type": "string"},
                "confidentiality": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/classification"},
                "author": {"type": ["string", "null"]},
                "approval_state": {
                  "type": "string",
                  "enum": ["draft", "in_review", "approved", "executed", "superseded", "unknown"]
                },
                "observation_date": {"type": ["string", "null"]},
                "effective_date": {"type": ["string", "null"]},
                "deliverable_selection": {
                  "type": "array",
                  "items": {"type": "string"}
                },
                "classification_basis": {
                  "type": "string",
                  "enum": [
                    "deterministic_marker",
                    "content_signature",
                    "explicit_designation",
                    "container_fallback",
                    "ambiguous_unknown"
                  ]
                },
                "authority_rank": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9
                },
                "origin_group_id": {"type": ["string", "null"]},
                "parent_transformations": {
                  "type": "array",
                  "items": {"type": "object"}
                },
                "coverage_scope": {"type": "object"},
                "sections": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["section_id", "semantic_family", "start_locator", "end_locator"],
                    "properties": {
                      "section_id": {"type": "string"},
                      "semantic_family": {"type": "string"},
                      "start_locator": {"type": "string"},
                      "end_locator": {"type": "string"},
                      "authority_rank": {"type": ["integer", "null"]}
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
