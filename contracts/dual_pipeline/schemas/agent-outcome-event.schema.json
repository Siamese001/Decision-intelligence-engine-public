{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nee:dual-pipeline:agent-outcome-event:1.0.0",
  "title": "NEE Agent Learning Outcome Event Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "schema_version",
    "artifact_id",
    "canonical_digest",
    "event_id",
    "trace_id",
    "span_id",
    "run_id",
    "outcome_type",
    "source_agent",
    "stage",
    "category",
    "observed_outcome",
    "confidence",
    "status",
    "created_at",
    "extensions"
  ],
  "properties": {
    "contract_id": {"const": "urn:nee:dual-pipeline:agent-outcome-event:1.0.0"},
    "schema_version": {"const": "1.0.0"},
    "artifact_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "canonical_digest": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/canonicalDigest"},
    "event_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "trace_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "span_id": {"type": "string", "pattern": "^[a-f0-9]{16}$"},
    "run_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "outcome_type": {
      "type": "string",
      "enum": [
        "adjudication_error",
        "retrieval_miss",
        "speaker_correction",
        "decision_override",
        "quality_check_failure",
        "maintenance_finding"
      ]
    },
    "source_agent": {"type": "string", "minLength": 1},
    "stage": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/stage"},
    "category": {"type": "string", "minLength": 1},
    "observed_outcome": {"type": "object"},
    "expected_or_corrected_outcome": {"type": ["object", "null"]},
    "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "provenance_receipt_id": {"type": ["string", "null"]},
    "status": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/status"},
    "created_at": {"type": "string", "format": "date-time"},
    "extensions": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/extensions"}
  }
}
