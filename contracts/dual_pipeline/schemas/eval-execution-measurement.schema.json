{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nee:dual-pipeline:eval-execution-measurement:1.0.0",
  "title": "NEE content-silent evaluation execution measurement",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_id", "schema_version", "artifact_id", "canonical_digest", "measurement_id", "evaluation_id", "suite_id", "case_id", "measurement_profile", "invariant_bindings_digest", "treatment_bindings", "attempts", "aggregate", "measurement_status", "issues", "measured_at", "extensions"],
  "properties": {
    "contract_id": {"const": "urn:nee:dual-pipeline:eval-execution-measurement:1.0.0"},
    "schema_version": {"const": "1.0.0"},
    "artifact_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "canonical_digest": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/canonicalDigest"},
    "measurement_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "evaluation_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "suite_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "case_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "measurement_profile": {"type": "string", "enum": ["deterministic_structural", "live_usage"]},
    "invariant_bindings_digest": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sha256"},
    "treatment_bindings": {"$ref": "urn:nee:dual-pipeline:eval-execution-measurement:1.0.0#/$defs/treatment"},
    "attempts": {"type": "array", "minItems": 1, "items": {"$ref": "urn:nee:dual-pipeline:eval-execution-measurement:1.0.0#/$defs/attempt"}},
    "aggregate": {"$ref": "urn:nee:dual-pipeline:eval-execution-measurement:1.0.0#/$defs/aggregate"},
    "measurement_status": {"type": "string", "enum": ["VALID", "INVALID"]},
    "issues": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"}},
    "measured_at": {"type": "string", "format": "date-time"},
    "extensions": {"const": {}}
  },
  "$defs": {
    "treatment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["treatment_id", "history_policy", "tool_output_policy", "budget_enforced", "no_progress_limit", "feature_path"],
      "properties": {
        "treatment_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
        "history_policy": {"type": "string", "enum": ["bounded", "append_completed"]},
        "tool_output_policy": {"type": "string", "enum": ["externalize", "inline"]},
        "budget_enforced": {"type": "boolean"},
        "no_progress_limit": {"type": "integer", "minimum": 1, "maximum": 20},
        "feature_path": {"type": "string", "enum": ["candidate", "legacy"]}
      }
    },
    "componentBytes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixed_controls", "current_step", "checkpoint", "evidence", "output_contract", "completed_history", "raw_tool_output", "previous_compiled_prompt", "other"],
      "properties": {
        "fixed_controls": {"type": "integer", "minimum": 0},
        "current_step": {"type": "integer", "minimum": 0},
        "checkpoint": {"type": "integer", "minimum": 0},
        "evidence": {"type": "integer", "minimum": 0},
        "output_contract": {"type": "integer", "minimum": 0},
        "completed_history": {"type": "integer", "minimum": 0},
        "raw_tool_output": {"type": "integer", "minimum": 0},
        "previous_compiled_prompt": {"type": "integer", "minimum": 0},
        "other": {"type": "integer", "minimum": 0}
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow_id", "node_id", "node_ordinal", "attempt_ordinal", "call_ordinal", "call_purpose", "step_contract_digest", "checkpoint_digest", "c0_projection_digest", "compiled_request_digest", "e1_context_digest", "budget_verdict_digest", "request_payload_digest", "request_serialized_bytes", "component_bytes", "tool_result_bytes", "externalized_tool_result_bytes", "e5_return_bytes", "compaction_before_bytes", "compaction_after_bytes", "provider_initialized", "provider_called", "provider_response_received", "usage_reported", "input_tokens", "cached_input_tokens", "uncached_input_tokens", "output_tokens", "total_tokens", "microcredits", "pricing_schedule_digest", "progress_before_digest", "progress_after_digest", "progress_delta", "unmet_requirement_delta", "required_evidence_count", "required_contradiction_count", "budget_status", "terminal_outcome"],
      "properties": {
        "workflow_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
        "node_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
        "node_ordinal": {"type": "integer", "minimum": 1},
        "attempt_ordinal": {"type": "integer", "minimum": 1},
        "call_ordinal": {"type": "integer", "minimum": 1},
        "call_purpose": {"type": "string", "enum": ["PRIMARY", "SCHEMA_REPAIR", "QUALITY_ESCALATION", "RETRY"]},
        "step_contract_digest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "checkpoint_digest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "c0_projection_digest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "compiled_request_digest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "e1_context_digest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "budget_verdict_digest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "request_payload_digest": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sha256"},
        "request_serialized_bytes": {"type": "integer", "minimum": 1},
        "component_bytes": {"$ref": "urn:nee:dual-pipeline:eval-execution-measurement:1.0.0#/$defs/componentBytes"},
        "tool_result_bytes": {"type": "integer", "minimum": 0},
        "externalized_tool_result_bytes": {"type": "integer", "minimum": 0},
        "e5_return_bytes": {"type": "integer", "minimum": 0},
        "compaction_before_bytes": {"type": "integer", "minimum": 0},
        "compaction_after_bytes": {"type": "integer", "minimum": 0},
        "provider_initialized": {"type": "boolean"},
        "provider_called": {"type": "boolean"},
        "provider_response_received": {"type": "boolean"},
        "usage_reported": {"type": "boolean"},
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "cached_input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "uncached_input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "total_tokens": {"type": ["integer", "null"], "minimum": 0},
        "microcredits": {"type": ["integer", "null"], "minimum": 0},
        "pricing_schedule_digest": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sha256"},
        "progress_before_digest": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sha256"},
        "progress_after_digest": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sha256"},
        "progress_delta": {"type": "integer", "minimum": 0},
        "unmet_requirement_delta": {"type": "integer", "maximum": 0},
        "required_evidence_count": {"type": "integer", "minimum": 0},
        "required_contradiction_count": {"type": "integer", "minimum": 0},
        "budget_status": {"type": "string", "enum": ["ALLOW", "BLOCK"]},
        "terminal_outcome": {"type": "string", "enum": ["IN_PROGRESS", "COMPLETED", "BLOCKED", "HITL_REQUIRED", "FAILED"]}
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt_count", "provider_initialization_count", "provider_call_count", "usage_reported_call_count", "usage_completeness", "progress_unit_count", "request_serialized_bytes_total", "request_serialized_bytes_max", "request_serialized_bytes_p50", "request_serialized_bytes_p95", "post_warmup_growth_bytes_per_node", "post_warmup_growth_percent_per_node", "input_tokens", "cached_input_tokens", "uncached_input_tokens", "output_tokens", "total_tokens", "read_write_ratio", "cached_input_share", "microcredits", "microcredits_per_progress_unit", "max_completed_history_bytes", "max_raw_tool_output_bytes", "max_previous_compiled_prompt_bytes", "max_tool_result_bytes", "max_e5_return_bytes", "no_progress_provider_call_count", "over_budget_provider_call_count", "compaction_reclaimed_bytes"],
      "properties": {
        "attempt_count": {"type": "integer", "minimum": 1},
        "provider_initialization_count": {"type": "integer", "minimum": 0},
        "provider_call_count": {"type": "integer", "minimum": 0},
        "usage_reported_call_count": {"type": "integer", "minimum": 0},
        "usage_completeness": {"type": "number", "minimum": 0, "maximum": 1},
        "progress_unit_count": {"type": "integer", "minimum": 0},
        "request_serialized_bytes_total": {"type": "integer", "minimum": 0},
        "request_serialized_bytes_max": {"type": "integer", "minimum": 0},
        "request_serialized_bytes_p50": {"type": "integer", "minimum": 0},
        "request_serialized_bytes_p95": {"type": "integer", "minimum": 0},
        "post_warmup_growth_bytes_per_node": {"type": "number"},
        "post_warmup_growth_percent_per_node": {"type": "number"},
        "input_tokens": {"type": "integer", "minimum": 0},
        "cached_input_tokens": {"type": "integer", "minimum": 0},
        "uncached_input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0},
        "read_write_ratio": {"type": "number", "minimum": 0},
        "cached_input_share": {"type": "number", "minimum": 0, "maximum": 1},
        "microcredits": {"type": "integer", "minimum": 0},
        "microcredits_per_progress_unit": {"type": "number", "minimum": 0},
        "max_completed_history_bytes": {"type": "integer", "minimum": 0},
        "max_raw_tool_output_bytes": {"type": "integer", "minimum": 0},
        "max_previous_compiled_prompt_bytes": {"type": "integer", "minimum": 0},
        "max_tool_result_bytes": {"type": "integer", "minimum": 0},
        "max_e5_return_bytes": {"type": "integer", "minimum": 0},
        "no_progress_provider_call_count": {"type": "integer", "minimum": 0},
        "over_budget_provider_call_count": {"type": "integer", "minimum": 0},
        "compaction_reclaimed_bytes": {"type": "integer", "minimum": 0}
      }
    }
  }
}
