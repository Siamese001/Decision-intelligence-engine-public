{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nee:dual-pipeline:query-plan:2.0.0",
  "title": "NEE destination-bound query execution plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_id", "schema_version", "artifact_id", "canonical_digest", "plan_id", "request_id", "run_id", "trace_id", "destination_decision_digest", "destination", "query_type", "materiality", "assurance_profile", "delivery_profile", "artifact_type", "l2_policy", "l2_policy_reason", "allowed_provider_class", "maximum_primary_calls", "maximum_repair_calls", "maximum_challenger_calls", "maximum_judge_calls", "required_output_schema", "provider_egress_allowed", "primary_entities", "time_horizon", "subquestions", "relationships_to_inspect", "evidence_requirements", "retrieval_mode", "allowed_lanes", "retrieval", "external_research", "prompt_blueprint", "output_schema", "exit_criteria", "extensions"],
  "properties": {
    "contract_id": {"const": "urn:nee:dual-pipeline:query-plan:2.0.0"},
    "schema_version": {"const": "2.0.0"},
    "artifact_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "canonical_digest": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/canonicalDigest"},
    "plan_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "request_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "run_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "trace_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "destination_decision_digest": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sha256"},
    "destination": {"type": "string", "enum": ["GRAPH_EVIDENCE_UTILITY", "NEE_DECISION_INTELLIGENCE"]},
    "query_type": {"type": "string", "enum": ["exact_lookup", "current_state_corroboration", "project_status_current", "project_status_history", "relationship_explanation", "cross_workstream_synthesis", "gap_risk_inconsistency", "opportunity_nba", "candidate_promotion_review"]},
    "materiality": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/materiality"},
    "assurance_profile": {"type": ["string", "null"], "enum": ["standard", "enhanced", null]},
    "delivery_profile": {"type": "string", "enum": ["internal_technical", "internal_executive", "client_technical", "client_executive", "commercial"]},
    "artifact_type": {"type": "string", "enum": ["answer", "decision_brief", "architecture_deck", "commercial_case", "evidence_export"]},
    "l2_policy": {"type": "string", "enum": ["forbidden", "required"]},
    "l2_policy_reason": {"type": "string", "minLength": 1},
    "allowed_provider_class": {"type": ["string", "null"], "enum": ["openai", null]},
    "maximum_primary_calls": {"type": "integer", "minimum": 0, "maximum": 1},
    "maximum_repair_calls": {"type": "integer", "minimum": 0, "maximum": 1},
    "maximum_challenger_calls": {"type": "integer", "minimum": 0, "maximum": 1},
    "maximum_judge_calls": {"type": "integer", "minimum": 0, "maximum": 2},
    "required_output_schema": {"type": "string", "minLength": 1},
    "provider_egress_allowed": {"type": "boolean"},
    "primary_entities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "time_horizon": {"type": ["string", "null"]},
    "subquestions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "relationships_to_inspect": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "evidence_requirements": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "retrieval_mode": {"type": "string", "enum": ["factual", "guidance", "candidate_review", "strategic", "status_snapshot_current", "status_snapshot_history"]},
    "allowed_lanes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "enum": ["approved", "candidate", "external_public"]}},
    "retrieval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exact_anchors", "semantic", "graph_hops", "lane_blending", "bm25", "typed_path_expansion", "connected_evidence_selection"],
      "properties": {
        "exact_anchors": {"type": "boolean"},
        "semantic": {"type": "boolean"},
        "graph_hops": {"type": "integer", "minimum": 0, "maximum": 3},
        "lane_blending": {"const": false},
        "bm25": {"type": "boolean"},
        "typed_path_expansion": {"type": "boolean"},
        "connected_evidence_selection": {"type": "boolean"}
      }
    },
    "external_research": {"type": "string", "enum": ["denied", "allowed_public_context", "required_public_fact"]},
    "prompt_blueprint": {"type": "string", "minLength": 1},
    "output_schema": {"type": "string", "minLength": 1},
    "exit_criteria": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "extensions": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/extensions"}
  },
  "oneOf": [
    {
      "properties": {
        "destination": {"const": "GRAPH_EVIDENCE_UTILITY"},
        "query_type": {"enum": ["exact_lookup", "current_state_corroboration", "project_status_current", "project_status_history"]},
        "assurance_profile": {"const": null},
        "l2_policy": {"const": "forbidden"},
        "allowed_provider_class": {"const": null},
        "maximum_primary_calls": {"const": 0},
        "maximum_repair_calls": {"const": 0},
        "maximum_challenger_calls": {"const": 0},
        "maximum_judge_calls": {"const": 0},
        "provider_egress_allowed": {"const": false}
      }
    },
    {
      "properties": {
        "destination": {"const": "NEE_DECISION_INTELLIGENCE"},
        "query_type": {"enum": ["relationship_explanation", "cross_workstream_synthesis", "gap_risk_inconsistency", "opportunity_nba", "candidate_promotion_review"]},
        "assurance_profile": {"const": "standard"},
        "l2_policy": {"const": "required"},
        "allowed_provider_class": {"const": "openai"},
        "maximum_primary_calls": {"const": 1},
        "maximum_repair_calls": {"const": 0},
        "maximum_challenger_calls": {"const": 0},
        "maximum_judge_calls": {"const": 1}
      }
    },
    {
      "properties": {
        "destination": {"const": "NEE_DECISION_INTELLIGENCE"},
        "query_type": {"enum": ["relationship_explanation", "cross_workstream_synthesis", "gap_risk_inconsistency", "opportunity_nba", "candidate_promotion_review"]},
        "assurance_profile": {"const": "enhanced"},
        "l2_policy": {"const": "required"},
        "allowed_provider_class": {"const": "openai"},
        "maximum_primary_calls": {"const": 1},
        "maximum_repair_calls": {"const": 1},
        "maximum_challenger_calls": {"const": 1},
        "maximum_judge_calls": {"const": 2}
      }
    }
  ]
}
