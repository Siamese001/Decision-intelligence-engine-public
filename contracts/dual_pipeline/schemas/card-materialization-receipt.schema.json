{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nee:dual-pipeline:card-materialization-receipt:1.0.0",
  "title": "NEE access-sliced card membership receipt",
  "description": "A sealed external receipt for graph-derived card membership. Card prose is never an input or evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "schema_version",
    "artifact_id",
    "canonical_digest",
    "receipt_id",
    "status",
    "card_id",
    "card_view_id",
    "view_version",
    "selector_digest",
    "generation_id",
    "graph_sha256",
    "authorization_context_digest",
    "authority_mode",
    "lane_manifests",
    "object_manifest_digest",
    "lane_counts",
    "assertion_count",
    "evidence_count",
    "renderer_version",
    "materialized_at",
    "card_content_used_as_evidence",
    "provider_call_count",
    "extensions"
  ],
  "properties": {
    "contract_id": {
      "const": "urn:nee:dual-pipeline:card-materialization-receipt:1.0.0"
    },
    "schema_version": {"const": "1.0.0"},
    "artifact_id": {
      "$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"
    },
    "canonical_digest": {
      "$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/canonicalDigest"
    },
    "receipt_id": {
      "$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"
    },
    "status": {"const": "MATERIALIZED"},
    "card_id": {
      "$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"
    },
    "card_view_id": {
      "$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"
    },
    "view_version": {"type": "integer", "minimum": 1},
    "selector_digest": {
      "$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sha256"
    },
    "generation_id": {
      "$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"
    },
    "graph_sha256": {
      "$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sha256"
    },
    "authorization_context_digest": {
      "$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sha256"
    },
    "authority_mode": {
      "type": "string",
      "enum": ["approved_only", "candidate_review"]
    },
    "lane_manifests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved", "candidate_review"],
      "properties": {
        "approved": {
          "type": "array",
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {
            "$ref": "urn:nee:dual-pipeline:card-materialization-receipt:1.0.0#/$defs/assertionMembership"
          }
        },
        "candidate_review": {
          "type": "array",
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {
            "$ref": "urn:nee:dual-pipeline:card-materialization-receipt:1.0.0#/$defs/assertionMembership"
          }
        }
      }
    },
    "object_manifest_digest": {
      "$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sha256"
    },
    "lane_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved", "candidate_review"],
      "properties": {
        "approved": {"type": "integer", "minimum": 0},
        "candidate_review": {"type": "integer", "minimum": 0}
      }
    },
    "assertion_count": {"type": "integer", "minimum": 0},
    "evidence_count": {"type": "integer", "minimum": 0},
    "renderer_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "materialized_at": {"type": "string", "format": "date-time"},
    "card_content_used_as_evidence": {"const": false},
    "provider_call_count": {"const": 0},
    "extensions": {
      "$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/extensions"
    }
  },
  "$defs": {
    "assertionMembership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_type", "object_id", "evidence_ids", "facets"],
      "properties": {
        "object_type": {"const": "assertion"},
        "object_id": {
          "$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"
          }
        },
        "facets": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_:-]{1,63}$"
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$"
            }
          }
        }
      }
    }
  }
}
