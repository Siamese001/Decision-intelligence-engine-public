{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nee:dual-pipeline:query-route-eval-result:1.0.0",
  "title": "Provider-free query destination evaluation result",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_id", "schema_version", "artifact_id", "canonical_digest", "evaluation_id", "suite_id", "suite_digest", "suite_file_sha256", "policy_digest", "runtime_boundary", "case_results", "confusion_cells", "metrics", "gates", "provider_initialization_count", "provider_call_count", "embedding_call_count", "l2_call_count", "graph_mutation_count", "status", "evaluated_at", "extensions"],
  "properties": {
    "contract_id": {"const": "urn:nee:dual-pipeline:query-route-eval-result:1.0.0"},
    "schema_version": {"const": "1.0.0"},
    "artifact_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "canonical_digest": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/canonicalDigest"},
    "evaluation_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "suite_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "suite_digest": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sha256"},
    "suite_file_sha256": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sha256"},
    "policy_digest": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sha256"},
    "runtime_boundary": {"const": "PRE_RETRIEVAL_PROVIDER_FREE_ROUTING"},
    "case_results": {"type": "array", "minItems": 1, "items": {"$ref": "urn:nee:dual-pipeline:query-route-eval-result:1.0.0#/$defs/caseResult"}},
    "confusion_cells": {"type": "array", "minItems": 1, "items": {"$ref": "urn:nee:dual-pipeline:query-route-eval-result:1.0.0#/$defs/confusionCell"}},
    "metrics": {"$ref": "urn:nee:dual-pipeline:query-route-eval-result:1.0.0#/$defs/metrics"},
    "gates": {"type": "object", "additionalProperties": {"type": "boolean"}, "minProperties": 1},
    "provider_initialization_count": {"const": 0},
    "provider_call_count": {"const": 0},
    "embedding_call_count": {"const": 0},
    "l2_call_count": {"const": 0},
    "graph_mutation_count": {"const": 0},
    "status": {"type": "string", "enum": ["PASS", "FAIL"]},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "extensions": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/extensions"}
  },
  "$defs": {
    "destination": {"type": "string", "enum": ["GENERAL_ASSISTANT_HANDOFF", "OPERATIONAL_WORKFLOW_HANDOFF", "GRAPH_EVIDENCE_UTILITY", "NEE_DECISION_INTELLIGENCE", "ROUTE_AMBIGUOUS", "ERROR"]},
    "queryType": {"type": ["string", "null"], "enum": [null, "exact_lookup", "current_state", "current_state_corroboration", "project_status_current", "project_status_history", "relationship_explanation", "cross_workstream_synthesis", "gap_risk_inconsistency", "opportunity_nba", "candidate_promotion_review"]},
    "caseResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "critical", "expected_destination", "predicted_destination", "expected_query_type", "predicted_query_type", "expected_materiality", "predicted_materiality", "expected_eligibility_status", "predicted_eligibility_status", "expected_enters_query_runtime", "predicted_enters_query_runtime", "status", "cause_codes"],
      "properties": {
        "case_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
        "critical": {"type": "boolean"},
        "expected_destination": {"$ref": "urn:nee:dual-pipeline:query-route-eval-result:1.0.0#/$defs/destination"},
        "predicted_destination": {"$ref": "urn:nee:dual-pipeline:query-route-eval-result:1.0.0#/$defs/destination"},
        "expected_query_type": {"$ref": "urn:nee:dual-pipeline:query-route-eval-result:1.0.0#/$defs/queryType"},
        "predicted_query_type": {"$ref": "urn:nee:dual-pipeline:query-route-eval-result:1.0.0#/$defs/queryType"},
        "expected_materiality": {"type": "string", "enum": ["low", "medium", "high"]},
        "predicted_materiality": {"type": ["string", "null"], "enum": [null, "low", "medium", "high"]},
        "expected_eligibility_status": {"type": "string", "enum": ["NOT_ELIGIBLE", "NOT_APPLICABLE", "ELIGIBLE_PRE_RETRIEVAL", "AMBIGUOUS"]},
        "predicted_eligibility_status": {"type": ["string", "null"], "enum": [null, "NOT_ELIGIBLE", "NOT_APPLICABLE", "ELIGIBLE_PRE_RETRIEVAL", "AMBIGUOUS"]},
        "expected_enters_query_runtime": {"type": "boolean"},
        "predicted_enters_query_runtime": {"type": "boolean"},
        "status": {"type": "string", "enum": ["PASS", "FAIL"]},
        "cause_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}}
      }
    },
    "confusionCell": {
      "type": "object", "additionalProperties": false, "required": ["expected_destination", "predicted_destination", "count"],
      "properties": {"expected_destination": {"$ref": "urn:nee:dual-pipeline:query-route-eval-result:1.0.0#/$defs/destination"}, "predicted_destination": {"$ref": "urn:nee:dual-pipeline:query-route-eval-result:1.0.0#/$defs/destination"}, "count": {"type": "integer", "minimum": 1}}
    },
    "metrics": {
      "type": "object", "additionalProperties": false,
      "required": ["case_count", "correct_case_count", "destination_accuracy", "graph_entry_true_positive_count", "graph_entry_false_positive_count", "graph_entry_false_negative_count", "graph_entry_precision", "graph_entry_recall", "nee_decision_expected_count", "nee_decision_true_positive_count", "nee_decision_false_negative_count", "nee_decision_recall", "critical_false_negative_count"],
      "properties": {
        "case_count": {"type": "integer", "minimum": 1}, "correct_case_count": {"type": "integer", "minimum": 0},
        "destination_accuracy": {"type": "number", "minimum": 0, "maximum": 1},
        "graph_entry_true_positive_count": {"type": "integer", "minimum": 0}, "graph_entry_false_positive_count": {"type": "integer", "minimum": 0}, "graph_entry_false_negative_count": {"type": "integer", "minimum": 0},
        "graph_entry_precision": {"type": "number", "minimum": 0, "maximum": 1}, "graph_entry_recall": {"type": "number", "minimum": 0, "maximum": 1},
        "nee_decision_expected_count": {"type": "integer", "minimum": 0}, "nee_decision_true_positive_count": {"type": "integer", "minimum": 0}, "nee_decision_false_negative_count": {"type": "integer", "minimum": 0}, "nee_decision_recall": {"type": "number", "minimum": 0, "maximum": 1},
        "critical_false_negative_count": {"type": "integer", "minimum": 0}
      }
    }
  }
}
