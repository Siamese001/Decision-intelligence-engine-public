{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nee:dual-pipeline:query-route-eval-suite:1.0.0",
  "title": "Provider-free query destination evaluation suite",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_id", "schema_version", "artifact_id", "canonical_digest", "suite_id", "policy_digest", "runtime_boundary", "cases", "thresholds", "created_at", "extensions"],
  "properties": {
    "contract_id": {"const": "urn:nee:dual-pipeline:query-route-eval-suite:1.0.0"},
    "schema_version": {"const": "1.0.0"},
    "artifact_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "canonical_digest": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/canonicalDigest"},
    "suite_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "policy_digest": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sha256"},
    "runtime_boundary": {"const": "PRE_RETRIEVAL_PROVIDER_FREE_ROUTING"},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "urn:nee:dual-pipeline:query-route-eval-suite:1.0.0#/$defs/case"}},
    "thresholds": {"$ref": "urn:nee:dual-pipeline:query-route-eval-suite:1.0.0#/$defs/thresholds"},
    "created_at": {"type": "string", "format": "date-time"},
    "extensions": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/extensions"}
  },
  "$defs": {
    "destination": {"type": "string", "enum": ["GENERAL_ASSISTANT_HANDOFF", "OPERATIONAL_WORKFLOW_HANDOFF", "GRAPH_EVIDENCE_UTILITY", "NEE_DECISION_INTELLIGENCE", "ROUTE_AMBIGUOUS"]},
    "queryType": {"type": ["string", "null"], "enum": [null, "exact_lookup", "current_state", "current_state_corroboration", "project_status_current", "project_status_history", "relationship_explanation", "cross_workstream_synthesis", "gap_risk_inconsistency", "opportunity_nba", "candidate_promotion_review"]},
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "tags", "critical", "question", "classification", "audiences", "authorized", "delivery_profile", "artifact_type", "expected"],
      "properties": {
        "case_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
        "tags": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 64}},
        "critical": {"type": "boolean"},
        "question": {"type": "string", "minLength": 1, "maxLength": 4000},
        "classification": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/classification"},
        "audiences": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/audiences"},
        "authorized": {"type": "boolean"},
        "delivery_profile": {"type": "string", "enum": ["internal_technical", "internal_executive", "client_technical", "client_executive", "commercial"]},
        "artifact_type": {"type": "string", "enum": ["answer", "decision_brief", "architecture_deck", "commercial_case", "evidence_export"]},
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["destination", "query_type", "materiality", "eligibility_status", "enters_query_runtime"],
          "properties": {
            "destination": {"$ref": "urn:nee:dual-pipeline:query-route-eval-suite:1.0.0#/$defs/destination"},
            "query_type": {"$ref": "urn:nee:dual-pipeline:query-route-eval-suite:1.0.0#/$defs/queryType"},
            "materiality": {"type": "string", "enum": ["low", "medium", "high"]},
            "eligibility_status": {"type": "string", "enum": ["NOT_ELIGIBLE", "NOT_APPLICABLE", "ELIGIBLE_PRE_RETRIEVAL", "AMBIGUOUS"]},
            "enters_query_runtime": {"type": "boolean"}
          }
        }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_destination_accuracy", "minimum_graph_entry_precision", "minimum_graph_entry_recall", "minimum_nee_decision_recall", "maximum_critical_false_negative_count"],
      "properties": {
        "minimum_destination_accuracy": {"type": "number", "minimum": 0, "maximum": 1},
        "minimum_graph_entry_precision": {"type": "number", "minimum": 0, "maximum": 1},
        "minimum_graph_entry_recall": {"type": "number", "minimum": 0, "maximum": 1},
        "minimum_nee_decision_recall": {"type": "number", "minimum": 0, "maximum": 1},
        "maximum_critical_false_negative_count": {"type": "integer", "minimum": 0}
      }
    }
  }
}
