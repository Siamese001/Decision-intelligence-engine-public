{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nee:dual-pipeline:retrieval-release-suite:1.0.0",
  "title": "NEE BGE-M3 retrieval release suite",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_id", "schema_version", "artifact_id", "canonical_digest", "suite_id", "execution_tier", "acceptance_policy", "cases", "coverage", "created_at", "extensions"],
  "properties": {
    "contract_id": {"const": "urn:nee:dual-pipeline:retrieval-release-suite:1.0.0"},
    "schema_version": {"const": "1.0.0"},
    "artifact_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "canonical_digest": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/canonicalDigest"},
    "suite_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "execution_tier": {"const": "E3"},
    "acceptance_policy": {"$ref": "urn:nee:dual-pipeline:retrieval-release-suite:1.0.0#/$defs/policyBinding"},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "urn:nee:dual-pipeline:retrieval-release-suite:1.0.0#/$defs/case"}},
    "coverage": {"type": "array", "items": {"$ref": "urn:nee:dual-pipeline:retrieval-release-suite:1.0.0#/$defs/coverage"}},
    "created_at": {"type": "string", "format": "date-time"},
    "extensions": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/extensions"}
  },
  "$defs": {
    "policyBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "policy_version", "policy_digest", "owner"],
      "properties": {
        "policy_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
        "policy_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "policy_digest": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sha256"},
        "owner": {"type": "string", "minLength": 3, "maxLength": 256}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "scope", "query_kind", "critical", "query", "classification", "audiences", "lane", "retrieval_mode", "top_k", "expected_record_ids", "forbidden_record_ids"],
      "properties": {
        "case_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
        "scope": {"type": "string", "enum": ["core", "delta"]},
        "query_kind": {"type": "string", "enum": ["semantic_paraphrase", "alias", "relationship", "hard_negative", "lane_isolation", "acl_boundary", "stale_or_superseded"]},
        "critical": {"type": "boolean"},
        "query": {"type": "string", "minLength": 1, "maxLength": 4000},
        "classification": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/classification"},
        "audiences": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/audiences"},
        "lane": {"type": "string", "enum": ["approved", "candidate", "external_public"]},
        "retrieval_mode": {"type": "string", "enum": ["factual", "guidance", "candidate_review", "candidate_evaluation", "candidate_guidance", "entity_navigation", "candidate_entity_navigation", "strategic"]},
        "top_k": {"type": "integer", "minimum": 1, "maximum": 100},
        "facet_filters": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 256}
          },
          "propertyNames": {"minLength": 1, "maxLength": 128}
        },
        "allowed_assertion_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"}
        },
        "expected_record_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"}},
        "forbidden_record_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"}}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "change_kind", "case_ids", "relationship_applicable", "stale_or_superseded_applicable"],
      "properties": {
        "record_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
        "change_kind": {"type": "string", "enum": ["added_or_changed", "removed"]},
        "retrieval_expected": {
          "type": "boolean",
          "description": "False when the indexed projection is intentionally excluded from every governed retrieval mode and must remain forbidden."
        },
        "case_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"}},
        "relationship_applicable": {"type": "boolean"},
        "stale_or_superseded_applicable": {"type": "boolean"}
      }
    }
  }
}
