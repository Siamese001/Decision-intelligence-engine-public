{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nee:dual-pipeline:strategic-evidence-packet:1.0.0",
  "title": "NEE role-separated strategic evidence portfolio",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_id", "schema_version", "artifact_id", "canonical_digest", "packet_id", "query_run_id", "query_type", "graph_snapshot", "source_packet_digest", "channels", "role_counts", "channel_counts", "portfolio_digest", "automatic_graph_mutation_count", "extensions"],
  "properties": {
    "contract_id": {"const": "urn:nee:dual-pipeline:strategic-evidence-packet:1.0.0"},
    "schema_version": {"const": "1.0.0"},
    "artifact_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "canonical_digest": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/canonicalDigest"},
    "packet_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "query_run_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "query_type": {"const": "opportunity_nba"},
    "graph_snapshot": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "source_packet_digest": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sha256"},
    "channels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objectives", "current_state", "diagnostics", "principles", "options", "internal_context", "external_patterns", "outcomes", "counterevidence", "gaps"],
      "properties": {
        "objectives": {"$ref": "urn:nee:dual-pipeline:strategic-evidence-packet:1.0.0#/$defs/rows"},
        "current_state": {"$ref": "urn:nee:dual-pipeline:strategic-evidence-packet:1.0.0#/$defs/rows"},
        "diagnostics": {"$ref": "urn:nee:dual-pipeline:strategic-evidence-packet:1.0.0#/$defs/rows"},
        "principles": {"$ref": "urn:nee:dual-pipeline:strategic-evidence-packet:1.0.0#/$defs/rows"},
        "options": {"$ref": "urn:nee:dual-pipeline:strategic-evidence-packet:1.0.0#/$defs/rows"},
        "internal_context": {"$ref": "urn:nee:dual-pipeline:strategic-evidence-packet:1.0.0#/$defs/rows"},
        "external_patterns": {"$ref": "urn:nee:dual-pipeline:strategic-evidence-packet:1.0.0#/$defs/rows"},
        "outcomes": {"$ref": "urn:nee:dual-pipeline:strategic-evidence-packet:1.0.0#/$defs/rows"},
        "counterevidence": {"$ref": "urn:nee:dual-pipeline:strategic-evidence-packet:1.0.0#/$defs/rows"},
        "gaps": {"$ref": "urn:nee:dual-pipeline:strategic-evidence-packet:1.0.0#/$defs/rows"}
      }
    },
    "role_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "channel_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objectives", "current_state", "diagnostics", "principles", "options", "internal_context", "external_patterns", "outcomes", "counterevidence", "gaps"],
      "properties": {
        "objectives": {"type": "integer", "minimum": 0},
        "current_state": {"type": "integer", "minimum": 0},
        "diagnostics": {"type": "integer", "minimum": 0},
        "principles": {"type": "integer", "minimum": 0},
        "options": {"type": "integer", "minimum": 0},
        "internal_context": {"type": "integer", "minimum": 0},
        "external_patterns": {"type": "integer", "minimum": 0},
        "outcomes": {"type": "integer", "minimum": 0},
        "counterevidence": {"type": "integer", "minimum": 0},
        "gaps": {"type": "integer", "minimum": 0}
      }
    },
    "portfolio_digest": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sha256"},
    "automatic_graph_mutation_count": {"const": 0},
    "extensions": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/extensions"}
  },
  "$defs": {
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["record_id", "lane", "knowledge_role", "authority_scope", "applicability_scope", "modality", "realization_state", "answer_use", "evidence_ids"],
        "properties": {
          "record_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
          "lane": {"type": "string", "enum": ["approved", "candidate", "external_public"]},
          "knowledge_role": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/strategicProfile/properties/knowledge_role"},
          "authority_scope": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/strategicProfile/properties/authority_scope"},
          "applicability_scope": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/strategicProfile/properties/applicability_scope"},
          "modality": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/strategicProfile/properties/modality"},
          "realization_state": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/strategicProfile/properties/realization_state"},
          "answer_use": {"type": "string", "enum": ["factual_answer", "candidate_hypothesis", "guidance", "strategic_context", "decision_constraint", "external_analogy"]},
          "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"}}
        }
      }
    }
  }
}
