{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nee:dual-pipeline:retrieval-record:1.0.0",
  "title": "NEE semantically complete retrieval record",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_id", "schema_version", "artifact_id", "canonical_digest", "record_id", "record_type", "namespace", "lane", "title", "canonical_entities", "retrieval_text", "retrieval_text_hash", "evidence_cluster_id", "evidence_ids", "graph_snapshot", "classification", "audiences", "lifecycle", "effective_date", "action_status", "extensions"],
  "properties": {
    "contract_id": {"const": "urn:nee:dual-pipeline:retrieval-record:1.0.0"},
    "schema_version": {"const": "1.0.0"},
    "artifact_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "canonical_digest": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/canonicalDigest"},
    "record_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "record_type": {"type": "string", "enum": ["assertion", "edge", "source_chunk", "action_item", "architecture_component", "architecture_relationship", "entity_facet"]},
    "retrieval_kind": {"type": "string", "enum": ["assertion", "relationship_assertion", "entity_facet", "evidence_span", "guidance", "routing_intent", "schema"]},
    "epistemic_status": {"type": "string", "enum": ["candidate", "approved", "disputed", "superseded", "retracted"]},
    "provenance_kind": {"type": "string", "enum": ["source_bound", "direct_source", "derived", "policy", "observed", "user_supplied"]},
    "answer_use": {"type": "string", "enum": ["factual_answer", "candidate_hypothesis", "guidance", "citation_only", "navigation_only", "routing_only", "implementation_only", "strategic_context", "decision_constraint", "external_analogy"]},
    "evidence_stratum": {"type": "string", "enum": ["MUST_USE", "SUPPORTING", "CONTRADICTS", "BACKGROUND", "DEFINITIONS", "LINEAGE", "EXCLUDED"]},
    "strategic_profile": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/strategicProfile"},
    "namespace": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"},
    "lane": {"type": "string", "enum": ["approved", "candidate", "external_public"]},
    "title": {"type": "string", "minLength": 1},
    "canonical_entities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"}},
    "retrieval_text": {"type": "string", "minLength": 1, "maxLength": 8000},
    "retrieval_text_hash": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sha256"},
    "evidence_cluster_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"}},
    "graph_snapshot": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "classification": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/classification"},
    "audiences": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/audiences"},
    "lifecycle": {"type": "string", "enum": ["candidate", "current", "superseded", "historical"]},
    "effective_date": {"type": ["string", "null"], "format": "date"},
    "action_status": {"type": ["string", "null"], "enum": ["open", "planned", "completed", "cancelled", null]},
    "extensions": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/extensions"}
  }
}
