{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nee:dual-pipeline:query-classification:1.0.0",
  "title": "NEE governed query route and complexity classification",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_id", "schema_version", "artifact_id", "canonical_digest", "classification_id", "request_id", "run_id", "trace_id", "query_type", "query_complexity", "materiality", "proposed_query_type", "proposed_query_complexity", "proposed_materiality", "source", "confidence", "signals", "policy_clamps", "post_retrieval_recheck", "classifier_call_required", "classifier_call_status", "classifier_call_count", "classifier_model", "classifier_failure_code", "classifier_input_tokens", "classifier_output_tokens", "classifier_total_tokens", "classifier_latency_ms", "policy_digest", "extensions"],
  "properties": {
    "contract_id": {"const": "urn:nee:dual-pipeline:query-classification:1.0.0"},
    "schema_version": {"const": "1.0.0"},
    "artifact_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "canonical_digest": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/canonicalDigest"},
    "classification_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "request_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "run_id": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/artifactId"},
    "trace_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "query_type": {"type": "string", "enum": ["exact_lookup", "current_state_corroboration", "project_status_current", "project_status_history", "relationship_explanation", "cross_workstream_synthesis", "gap_risk_inconsistency", "opportunity_nba", "candidate_promotion_review"]},
    "query_complexity": {"type": "string", "enum": ["low", "normal", "high", "most_complex"]},
    "materiality": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/materiality"},
    "proposed_query_type": {"type": ["string", "null"], "enum": ["exact_lookup", "current_state_corroboration", "project_status_current", "project_status_history", "relationship_explanation", "cross_workstream_synthesis", "gap_risk_inconsistency", "opportunity_nba", "candidate_promotion_review", null]},
    "proposed_query_complexity": {"type": ["string", "null"], "enum": ["low", "normal", "high", "most_complex", null]},
    "proposed_materiality": {"type": ["string", "null"], "enum": ["low", "medium", "high", null]},
    "source": {"type": "string", "enum": ["operator_override", "deterministic", "classifier_llm", "policy_fallback"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "signals": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "policy_clamps": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "post_retrieval_recheck": {"const": true},
    "classifier_call_required": {"type": "boolean"},
    "classifier_call_status": {"type": "string", "enum": ["SKIPPED", "PASS", "FAILED"]},
    "classifier_call_count": {"type": "integer", "minimum": 0, "maximum": 1},
    "classifier_model": {"type": ["string", "null"]},
    "classifier_failure_code": {"type": ["string", "null"]},
    "classifier_input_tokens": {"type": "integer", "minimum": 0},
    "classifier_output_tokens": {"type": "integer", "minimum": 0},
    "classifier_total_tokens": {"type": "integer", "minimum": 0},
    "classifier_latency_ms": {"type": "number", "minimum": 0},
    "policy_digest": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/sha256"},
    "extensions": {"$ref": "urn:nee:dual-pipeline:common:1.0.0#/$defs/extensions"}
  }
}
