{
  "schema_version": "1.0",
  "artifact_type": "decision_intelligence_semantic_spine_v2_contract",
  "contract_id": "nee-decision-intelligence-semantic-spine-v2",
  "contract_version": "2026-08-10.1",
  "status": "IMPLEMENTED_NO_GRAPH_MIGRATION",
  "purpose": "Define enforceable target semantics for decision intelligence without rewriting the active NEE Knowledge Base.",
  "node_types": [
    "initiative",
    "organization",
    "person",
    "owner_group",
    "capability",
    "pain_point",
    "support_scope",
    "status_observation",
    "metric_definition",
    "metric_observation",
    "dependency_observation",
    "readiness_observation",
    "risk",
    "decision",
    "ai_use_case",
    "agent",
    "tool",
    "evaluation_run",
    "derived_artifact",
    "evidence_item"
  ],
  "relations": {
    "owns": {"source": ["organization", "person", "owner_group"], "target": ["initiative", "capability"], "qualifiers": ["effective_from", "source_assertion_ids"]},
    "leads": {"source": ["organization", "person", "owner_group"], "target": ["initiative", "capability"], "qualifiers": ["effective_from", "source_assertion_ids"]},
    "supports": {"source": ["organization", "person", "owner_group"], "target": ["initiative", "capability"], "qualifiers": ["support_scope_id", "source_assertion_ids"]},
    "has_status_observation": {"source": ["initiative"], "target": ["status_observation"], "qualifiers": ["source_assertion_ids"]},
    "has_pain_point": {"source": ["initiative", "organization"], "target": ["pain_point"], "qualifiers": ["source_assertion_ids"]},
    "measured_by": {"source": ["initiative", "capability", "ai_use_case"], "target": ["metric_definition"], "qualifiers": ["source_assertion_ids"]},
    "has_metric_observation": {"source": ["metric_definition"], "target": ["metric_observation"], "qualifiers": ["source_assertion_ids"]},
    "depends_on": {"source": ["initiative", "capability", "ai_use_case"], "target": ["initiative", "capability", "dependency_observation"], "qualifiers": ["source_assertion_ids"]},
    "informed_by": {"source": ["decision", "derived_artifact", "ai_use_case"], "target": ["evidence_item", "status_observation", "metric_observation"], "qualifiers": ["source_assertion_ids"]},
    "contradicted_by": {"source": ["decision", "derived_artifact", "ai_use_case"], "target": ["evidence_item"], "qualifiers": ["source_assertion_ids"]},
    "conflicts_with": {"source": ["initiative", "capability", "ai_use_case", "decision"], "target": ["initiative", "capability", "ai_use_case", "decision"], "qualifiers": ["conflict_type", "source_assertion_ids"]},
    "duplicates": {"source": ["initiative", "capability", "ai_use_case"], "target": ["initiative", "capability", "ai_use_case"], "qualifiers": ["source_assertion_ids"]},
    "evaluated_by": {"source": ["agent", "ai_use_case", "derived_artifact"], "target": ["evaluation_run"], "qualifiers": ["source_assertion_ids"]},
    "uses_tool": {"source": ["agent", "ai_use_case"], "target": ["tool"], "qualifiers": ["source_assertion_ids"]}
  },
  "invariants": [
    "OWNS_OR_LEADS is legacy-only and cannot be emitted by v2.",
    "RELATED_TO is not a v2 decision relationship.",
    "A support relationship requires a named support_scope_id; unspecified or blanket support is rejected.",
    "Every v2 relationship requires one or more source assertion IDs.",
    "A decision or derived artifact may be informed by evidence but cannot become a canonical fact through this contract.",
    "Status and metric values are observations, not timeless initiative properties."
  ],
  "gate": {"provider_calls_allowed": 0, "graph_mutations_allowed": 0, "release_activation_allowed": false}
}
