{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:nee:dual-pipeline:l0:quarantine-profile:1.0.0",
  "title": "QuarantineProfile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "strategic_value",
    "evidence_quality",
    "confidence",
    "tacticality",
    "is_quarantined",
    "quarantine_reason"
  ],
  "properties": {
    "strategic_value": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "evidence_quality": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "tacticality": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "is_quarantined": { "type": "boolean" },
    "quarantine_reason": { "type": "string" }
  }
}
